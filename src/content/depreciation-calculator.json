{
  "slug": "depreciation-calculator",
  "meta_title": "Depreciation Calculator | Straight-Line Depreciation Calculator",
  "meta_description": "Free depreciation calculator using the straight-line method. Enter asset cost, salvage value, and useful life to calculate annual depreciation.",
  "h1": "Depreciation Calculator",
  "subtitle": "Enter the <strong>asset cost</strong>, <strong>salvage value</strong>, and <strong>useful life</strong>, and this <strong>depreciation calculator</strong> instantly works out the <strong>annual depreciation</strong> using the straight-line method.",
  "card": {
    "layout": "raw",
    "fields_html": "<div class=\"tool-card flex h-full flex-col rounded-2xl border border-border bg-surface shadow-sm shadow-black/5 dark:shadow-black/30\">\n  <div class=\"tool-card-head flex items-center gap-3 border-b border-border bg-surface-alt px-5 py-4 sm:px-6\"><span aria-hidden=\"true\" class=\"icon-badge flex h-10 w-10 flex-none items-center justify-center rounded-xl bg-lime-100 text-lime-600 dark:bg-lime-500/15 dark:text-lime-400\"><svg class=\"icon h-5 w-5\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M4 4v16h16\"/><path d=\"M4 8 10 12l3-2 7 6\"/></svg></span><div class=\"min-w-0\"><h1 class=\"text-base font-bold leading-snug text-text sm:text-lg\">{{H1}}</h1><p class=\"mt-0.5 truncate text-xs text-text-muted sm:text-sm\">{{HINT}}</p></div></div>\n  <div class=\"tool-card-body flex flex-1 flex-col p-5 sm:p-6\">\n    <div class=\"calc-row flex flex-wrap gap-4\">\n      <div class=\"calc-field mb-4 flex min-w-[140px] flex-1 flex-col gap-1.5\"><label for=\"asset_cost\" class=\"text-xs font-semibold uppercase tracking-wide text-text-muted\">Asset Cost ($)</label><input type=\"number\" id=\"asset_cost\" step=\"any\" placeholder=\"e.g. 10000\" oninput=\"calculate()\" class=\"w-full rounded-xl border border-border bg-surface-alt px-4 py-3 font-mono text-base text-text shadow-sm transition duration-150 placeholder:text-text-muted hover:border-border-strong focus:border-lime-500 focus:outline-none focus:ring-4 focus:ring-lime-500/15 dark:focus:border-lime-400 dark:focus:ring-lime-400/15\"></div>\n      <div class=\"calc-field mb-4 flex min-w-[140px] flex-1 flex-col gap-1.5\"><label for=\"salvage_value\" class=\"text-xs font-semibold uppercase tracking-wide text-text-muted\">Salvage Value ($)</label><input type=\"number\" id=\"salvage_value\" step=\"any\" placeholder=\"e.g. 1000\" oninput=\"calculate()\" class=\"w-full rounded-xl border border-border bg-surface-alt px-4 py-3 font-mono text-base text-text shadow-sm transition duration-150 placeholder:text-text-muted hover:border-border-strong focus:border-lime-500 focus:outline-none focus:ring-4 focus:ring-lime-500/15 dark:focus:border-lime-400 dark:focus:ring-lime-400/15\"></div>\n      <div class=\"calc-field mb-4 flex min-w-[140px] flex-1 flex-col gap-1.5\"><label for=\"useful_life\" class=\"text-xs font-semibold uppercase tracking-wide text-text-muted\">Useful Life (Years)</label><input type=\"number\" id=\"useful_life\" step=\"any\" placeholder=\"e.g. 5\" oninput=\"calculate()\" class=\"w-full rounded-xl border border-border bg-surface-alt px-4 py-3 font-mono text-base text-text shadow-sm transition duration-150 placeholder:text-text-muted hover:border-border-strong focus:border-lime-500 focus:outline-none focus:ring-4 focus:ring-lime-500/15 dark:focus:border-lime-400 dark:focus:ring-lime-400/15\"></div>\n    </div>\n    <div class=\"calc-results mt-auto space-y-2.5 rounded-xl border border-lime-100 bg-lime-50/60 p-4 dark:border-lime-500/20 dark:bg-lime-500/[0.06]\">\n      <div class=\"calc-result-row flex items-baseline justify-between gap-4\"><span class=\"label text-xs font-semibold uppercase tracking-wide text-text-muted\">Depreciation Rate:</span><output class=\"value font-mono text-sm text-text-secondary\" for=\"asset_cost salvage_value useful_life\" id=\"depreciation_rate\">–</output></div>\n      <div class=\"calc-result-row primary mt-1 flex items-center justify-between gap-4 border-t border-lime-200/70 pt-3 dark:border-lime-500/20\"><span class=\"label text-sm font-semibold text-text-secondary\">Annual Depreciation:</span><output class=\"value text-3xl font-extrabold tracking-tight text-lime-600 dark:text-lime-400\" for=\"asset_cost salvage_value useful_life\" id=\"result\">–</output></div>\n    </div>\n    <p class=\"calc-formula mt-3 text-center font-mono text-xs text-text-muted/80\" id=\"formula_display\"></p>\n  </div>\n</div>"
  },
  "script": "function calculate(){const cost=parseFloat(document.getElementById('asset_cost').value),salvage=parseFloat(document.getElementById('salvage_value').value),life=parseFloat(document.getElementById('useful_life').value),r=document.getElementById('result'),f=document.getElementById('formula_display'),dr=document.getElementById('depreciation_rate');if(!isNaN(cost)&&!isNaN(salvage)&&!isNaN(life)&&cost>=0&&salvage>=0&&life>0){const annual=(cost-salvage)/life,rate=cost>0?(annual/cost)*100:0;r.textContent='$'+formatNumber(annual);if(dr)dr.textContent=formatNumber(rate)+'%';if(f)f.textContent='($'+cost+' − $'+salvage+') ÷ '+life+' = $'+formatNumber(annual)+'/yr'}else{r.textContent='–';if(dr)dr.textContent='–';if(f)f.textContent=''}}\nfunction formatNumber(n){return Number.isInteger(n)?n.toString():parseFloat(n.toFixed(2)).toString()}",
  "content_html": "",
  "faq": [],
  "hint": "Enter asset cost, salvage value, and useful life to get annual depreciation."
}
