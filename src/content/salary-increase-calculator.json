{
  "slug": "salary-increase-calculator",
  "meta_title": "Salary Increase Calculator | Calculate Your Raise & New Salary",
  "meta_description": "Free salary increase calculator. Enter your current salary and raise percentage to instantly calculate your raise amount and new salary.",
  "h1": "Salary Increase Calculator",
  "subtitle": "Enter your <strong>current salary</strong> and your <strong>raise percentage</strong>, and this <strong>salary increase calculator</strong> instantly works out your <strong>raise amount</strong> and <strong>new salary</strong>.",
  "card": {
    "layout": "raw",
    "fields_html": "<div class=\"tool-card flex h-full flex-col rounded-2xl border border-border bg-surface shadow-sm shadow-black/5 dark:shadow-black/30\">\n  <div class=\"tool-card-head flex items-center gap-3 border-b border-border bg-surface-alt px-5 py-4 sm:px-6\"><span aria-hidden=\"true\" class=\"icon-badge flex h-10 w-10 flex-none items-center justify-center rounded-xl bg-rose-100 text-rose-600 dark:bg-rose-500/15 dark:text-rose-400\"><svg class=\"icon h-5 w-5\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M3 7h18v12H3V7Z\"/><path d=\"M3 7l3-4h12l3 4\"/><path d=\"M16 13h3\"/></svg></span><div class=\"min-w-0\"><h1 class=\"text-base font-bold leading-snug text-text sm:text-lg\">{{H1}}</h1><p class=\"mt-0.5 truncate text-xs text-text-muted sm:text-sm\">{{HINT}}</p></div></div>\n  <div class=\"tool-card-body flex flex-1 flex-col p-5 sm:p-6\">\n    <div class=\"calc-row flex flex-wrap gap-4\">\n      <div class=\"calc-field mb-4 flex min-w-[140px] flex-1 flex-col gap-1.5\"><label for=\"current_salary\" class=\"text-xs font-semibold uppercase tracking-wide text-text-muted\">Current Salary ($)</label><input type=\"number\" id=\"current_salary\" step=\"any\" placeholder=\"e.g. 60000\" oninput=\"calculate()\" class=\"w-full rounded-xl border border-border bg-surface-alt px-4 py-3 font-mono text-base text-text shadow-sm transition duration-150 placeholder:text-text-muted hover:border-border-strong focus:border-rose-500 focus:outline-none focus:ring-4 focus:ring-rose-500/15 dark:focus:border-rose-400 dark:focus:ring-rose-400/15\"></div>\n      <div class=\"calc-field mb-4 flex min-w-[140px] flex-1 flex-col gap-1.5\">\n        <label for=\"raise_percent\" class=\"text-xs font-semibold uppercase tracking-wide text-text-muted\">Raise</label>\n        <div class=\"input-row flex items-center gap-2.5\"><input type=\"number\" id=\"raise_percent\" step=\"any\" placeholder=\"e.g. 5\" oninput=\"calculate()\" class=\"w-full flex-1 rounded-xl border border-border bg-surface-alt px-4 py-3 font-mono text-base text-text shadow-sm transition duration-150 placeholder:text-text-muted hover:border-border-strong focus:border-rose-500 focus:outline-none focus:ring-4 focus:ring-rose-500/15 dark:focus:border-rose-400 dark:focus:ring-rose-400/15\"><span class=\"unit flex-none rounded-lg bg-rose-50 px-3 py-1.5 text-sm font-bold text-rose-700 dark:bg-rose-500/15 dark:text-rose-300\">%</span></div>\n      </div>\n    </div>\n    <div class=\"calc-results mt-auto space-y-2.5 rounded-xl border border-rose-100 bg-rose-50/60 p-4 dark:border-rose-500/20 dark:bg-rose-500/[0.06]\">\n      <div class=\"calc-result-row flex items-baseline justify-between gap-4\"><span class=\"label text-xs font-semibold uppercase tracking-wide text-text-muted\">Raise Amount:</span><output class=\"value font-mono text-sm text-text-secondary\" for=\"current_salary raise_percent\" id=\"raise_amount\">–</output></div>\n      <div class=\"calc-result-row primary mt-1 flex items-center justify-between gap-4 border-t border-rose-200/70 pt-3 dark:border-rose-500/20\"><span class=\"label text-sm font-semibold text-text-secondary\">New Salary:</span><output class=\"value text-3xl font-extrabold tracking-tight text-rose-600 dark:text-rose-400\" for=\"current_salary raise_percent\" id=\"result\">–</output></div>\n    </div>\n    <p class=\"calc-formula mt-3 text-center font-mono text-xs text-text-muted/80\" id=\"formula_display\"></p>\n  </div>\n</div>"
  },
  "script": "function calculate(){const cur=parseFloat(document.getElementById('current_salary').value),pct=parseFloat(document.getElementById('raise_percent').value),r=document.getElementById('result'),f=document.getElementById('formula_display'),ra=document.getElementById('raise_amount');if(!isNaN(cur)&&!isNaN(pct)&&cur>=0){const raise=cur*(pct/100),newSalary=cur+raise;r.textContent='$'+formatNumber(newSalary);if(ra)ra.textContent='$'+formatNumber(raise);if(f)f.textContent='$'+cur+' + ('+pct+'% × $'+cur+') = $'+formatNumber(newSalary)}else{r.textContent='–';if(ra)ra.textContent='–';if(f)f.textContent=''}}\nfunction formatNumber(n){return Number.isInteger(n)?n.toString():parseFloat(n.toFixed(2)).toString()}",
  "content_html": "",
  "faq": [],
  "hint": "Enter your current salary and raise % to get your new salary."
}
