  "subtitle": "Enter your <strong>revenue</strong> and <strong>cost of goods sold (COGS)</strong>, and this <strong>gross margin calculator</strong> instantly works out your <strong>gross profit</strong> and <strong>gross margin percentage</strong>.",
  "card": {
    "layout": "raw",
    "fields_html": "<div class=\"tool-card flex h-full flex-col overflow-hidden rounded-2xl border border-border bg-surface shadow-sm shadow-black/5 dark:shadow-black/30\">\n  <div class=\"tool-card-head flex items-center gap-3 border-b border-border bg-surface-alt px-5 py-4 sm:px-6\"><span aria-hidden=\"true\" class=\"icon-badge flex h-10 w-10 flex-none items-center justify-center rounded-xl bg-pink-100 text-pink-600 dark:bg-pink-500/15 dark:text-pink-400\"><svg class=\"icon h-5 w-5\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M3 21h18M6 21V10l4-3v14M14 21V7l4-3v17\"/></svg></span><div class=\"min-w-0\"><h1 class=\"text-base font-bold leading-snug text-text sm:text-lg\">{{H1}}</h1><p class=\"mt-0.5 truncate text-xs text-text-muted sm:text-sm\">{{HINT}}</p></div></div>\n  <div class=\"tool-card-body flex flex-1 flex-col p-5 sm:p-6\">\n    <div class=\"calc-row flex flex-wrap gap-4\">\n      <div class=\"calc-field mb-4 flex min-w-[140px] flex-1 flex-col gap-1.5\"><label for=\"gm_revenue\" class=\"text-xs font-semibold uppercase tracking-wide text-text-muted\">Revenue ($)</label><input type=\"number\" id=\"gm_revenue\" step=\"any\" placeholder=\"e.g. 100000\" oninput=\"calculate()\" class=\"w-full rounded-xl border border-border bg-surface-alt px-4 py-3 font-mono text-base text-text shadow-sm transition duration-150 placeholder:text-text-muted hover:border-border-strong focus:border-pink-500 focus:outline-none focus:ring-4 focus:ring-pink-500/15 dark:focus:border-pink-400 dark:focus:ring-pink-400/15\"></div>\n      <div class=\"calc-field mb-4 flex min-w-[140px] flex-1 flex-col gap-1.5\"><label for=\"gm_cogs\" class=\"text-xs font-semibold uppercase tracking-wide text-text-muted\">COGS ($)</label><input type=\"number\" id=\"gm_cogs\" step=\"any\" placeholder=\"e.g. 65000\" oninput=\"calculate()\" class=\"w-full rounded-xl border border-border bg-surface-alt px-4 py-3 font-mono text-base text-text shadow-sm transition duration-150 placeholder:text-text-muted hover:border-border-strong focus:border-pink-500 focus:outline-none focus:ring-4 focus:ring-pink-500/15 dark:focus:border-pink-400 dark:focus:ring-pink-400/15\"></div>\n    </div>\n    <div class=\"calc-results mt-auto space-y-2.5 rounded-xl border border-pink-100 bg-pink-50/60 p-4 dark:border-pink-500/20 dark:bg-pink-500/[0.06]\">\n      <div class=\"calc-result-row flex items-baseline justify-between gap-4\"><span class=\"label text-xs font-semibold uppercase tracking-wide text-text-muted\">Gross Profit:</span><output class=\"value font-mono text-sm text-text-secondary\" for=\"gm_revenue gm_cogs\" id=\"gross_profit\">–</output></div>\n      <div class=\"calc-result-row primary mt-1 flex items-center justify-between gap-4 border-t border-pink-200/70 pt-3 dark:border-pink-500/20\"><span class=\"label text-sm font-semibold text-text-secondary\">Gross Margin:</span><output class=\"value text-3xl font-extrabold tracking-tight text-pink-600 dark:text-pink-400\" for=\"gm_revenue gm_cogs\" id=\"result\">–</output></div>\n    </div>\n    <p class=\"calc-formula mt-3 text-center font-mono text-xs text-text-muted/80\" id=\"formula_display\"></p>\n  </div>\n</div>"
  },
  "script": "function calculate(){const rev=parseFloat(document.getElementById('gm_revenue').value),cogs=parseFloat(document.getElementById('gm_cogs').value),r=document.getElementById('result'),f=document.getElementById('formula_display'),gp=document.getElementById('gross_profit');if(!isNaN(rev)&&!isNaN(cogs)&&rev>0){const profit=rev-cogs,margin=(profit/rev)*100;r.textContent=formatNumber(margin)+'%';if(gp)gp.textContent='$'+formatNumber(profit);if(f)f.textContent='($'+rev+' − $'+cogs+') ÷ $'+rev+' × 100 = '+formatNumber(margin)+'%'}else{r.textContent='–';if(gp)gp.textContent='–';if(f)f.textContent=''}}\nfunction formatNumber(n){return Number.isInteger(n)?n.toString():parseFloat(n.toFixed(2)).toString()}",
  "content_html": "",
  "faq": [],
  "hint": "Enter revenue and COGS to get your gross margin percentage.",
  "long_tail_anchor": "Gross Margin Calculator – Revenue & COGS Margin %"
