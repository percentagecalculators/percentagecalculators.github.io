{
  "slug": "simple-interest-calculator",
  "meta_title": "Simple Interest Calculator | Calculate Interest & Total Amount",
  "meta_description": "Free simple interest calculator. Enter principal, annual rate, and time to instantly calculate interest earned and total amount.",
  "h1": "Simple Interest Calculator",
  "subtitle": "Enter the <strong>principal</strong>, <strong>annual interest rate</strong>, and <strong>time in years</strong>, and this <strong>simple interest calculator</strong> instantly shows the <strong>interest earned</strong> and the <strong>total amount</strong>.",
  "card": {
    "layout": "raw",
    "fields_html": "<div class=\"tool-card flex h-full flex-col rounded-2xl border border-border bg-surface shadow-sm shadow-black/5 dark:shadow-black/30\">\n  <div class=\"tool-card-head flex items-center gap-3 border-b border-border bg-surface-alt px-5 py-4 sm:px-6\"><span aria-hidden=\"true\" class=\"icon-badge flex h-10 w-10 flex-none items-center justify-center rounded-xl bg-amber-100 text-amber-600 dark:bg-amber-500/15 dark:text-amber-400\"><svg class=\"icon h-5 w-5\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M4 4v16h16\"/><path d=\"M4 18 20 4\"/></svg></span><div class=\"min-w-0\"><h1 class=\"text-base font-bold leading-snug text-text sm:text-lg\">{{H1}}</h1><p class=\"mt-0.5 truncate text-xs text-text-muted sm:text-sm\">{{HINT}}</p></div></div>\n  <div class=\"tool-card-body flex flex-1 flex-col p-5 sm:p-6\">\n    <div class=\"calc-row flex flex-wrap gap-4\">\n      <div class=\"calc-field mb-4 flex min-w-[140px] flex-1 flex-col gap-1.5\"><label for=\"principal\" class=\"text-xs font-semibold uppercase tracking-wide text-text-muted\">Principal ($)</label><input type=\"number\" id=\"principal\" step=\"any\" placeholder=\"e.g. 1000\" oninput=\"calculate()\" class=\"w-full rounded-xl border border-border bg-surface-alt px-4 py-3 font-mono text-base text-text shadow-sm transition duration-150 placeholder:text-text-muted hover:border-border-strong focus:border-amber-500 focus:outline-none focus:ring-4 focus:ring-amber-500/15 dark:focus:border-amber-400 dark:focus:ring-amber-400/15\"></div>\n      <div class=\"calc-field mb-4 flex min-w-[140px] flex-1 flex-col gap-1.5\">\n        <label for=\"annual_rate\" class=\"text-xs font-semibold uppercase tracking-wide text-text-muted\">Annual Rate</label>\n        <div class=\"input-row flex items-center gap-2.5\"><input type=\"number\" id=\"annual_rate\" step=\"any\" placeholder=\"e.g. 5\" oninput=\"calculate()\" class=\"w-full flex-1 rounded-xl border border-border bg-surface-alt px-4 py-3 font-mono text-base text-text shadow-sm transition duration-150 placeholder:text-text-muted hover:border-border-strong focus:border-amber-500 focus:outline-none focus:ring-4 focus:ring-amber-500/15 dark:focus:border-amber-400 dark:focus:ring-amber-400/15\"><span class=\"unit flex-none rounded-lg bg-amber-50 px-3 py-1.5 text-sm font-bold text-amber-700 dark:bg-amber-500/15 dark:text-amber-300\">%</span></div>\n      </div>\n      <div class=\"calc-field mb-4 flex min-w-[140px] flex-1 flex-col gap-1.5\"><label for=\"time_years\" class=\"text-xs font-semibold uppercase tracking-wide text-text-muted\">Time (Years)</label><input type=\"number\" id=\"time_years\" step=\"any\" placeholder=\"e.g. 3\" oninput=\"calculate()\" class=\"w-full rounded-xl border border-border bg-surface-alt px-4 py-3 font-mono text-base text-text shadow-sm transition duration-150 placeholder:text-text-muted hover:border-border-strong focus:border-amber-500 focus:outline-none focus:ring-4 focus:ring-amber-500/15 dark:focus:border-amber-400 dark:focus:ring-amber-400/15\"></div>\n    </div>\n    <div class=\"calc-results mt-auto space-y-2.5 rounded-xl border border-amber-100 bg-amber-50/60 p-4 dark:border-amber-500/20 dark:bg-amber-500/[0.06]\">\n      <div class=\"calc-result-row flex items-baseline justify-between gap-4\"><span class=\"label text-xs font-semibold uppercase tracking-wide text-text-muted\">Interest Earned:</span><output class=\"value font-mono text-sm text-text-secondary\" for=\"principal annual_rate time_years\" id=\"interest_amount\">–</output></div>\n      <div class=\"calc-result-row primary mt-1 flex items-center justify-between gap-4 border-t border-amber-200/70 pt-3 dark:border-amber-500/20\"><span class=\"label text-sm font-semibold text-text-secondary\">Total Amount:</span><output class=\"value text-3xl font-extrabold tracking-tight text-amber-600 dark:text-amber-400\" for=\"principal annual_rate time_years\" id=\"result\">–</output></div>\n    </div>\n    <p class=\"calc-formula mt-3 text-center font-mono text-xs text-text-muted/80\" id=\"formula_display\"></p>\n  </div>\n</div>"
  },
  "script": "function calculate(){const p=parseFloat(document.getElementById('principal').value),rate=parseFloat(document.getElementById('annual_rate').value),t=parseFloat(document.getElementById('time_years').value),r=document.getElementById('result'),f=document.getElementById('formula_display'),i=document.getElementById('interest_amount');if(!isNaN(p)&&!isNaN(rate)&&!isNaN(t)&&p>=0&&rate>=0&&t>=0){const interest=p*(rate/100)*t,total=p+interest;r.textContent='$'+formatNumber(total);if(i)i.textContent='$'+formatNumber(interest);if(f)f.textContent='$'+p+' × '+rate+'% × '+t+' = $'+formatNumber(interest)}else{r.textContent='–';if(i)i.textContent='–';if(f)f.textContent=''}}\nfunction formatNumber(n){return Number.isInteger(n)?n.toString():parseFloat(n.toFixed(2)).toString()}",
  "content_html": "",
  "faq": [],
  "hint": "Enter principal, annual rate, and time to get interest and total amount."
}
