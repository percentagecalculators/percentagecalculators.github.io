{
  "slug": "percentage-point-calculator",
  "meta_title": "Percentage Point Calculator | Difference Between Two Percentages",
  "meta_description": "Free percentage point calculator. Enter two percentages to instantly see the difference in percentage points and the relative percentage change.",
  "h1": "Percentage Point Calculator",
  "subtitle": "Enter two <strong>percentages</strong> and this <strong>percentage point calculator</strong> shows the <strong>difference in percentage points</strong> — not the same as the relative percentage change, which it also shows for comparison.",
  "card": {
    "layout": "raw",
    "fields_html": "<div class=\"tool-card flex h-full flex-col overflow-hidden rounded-2xl border border-border bg-surface shadow-sm shadow-black/5 dark:shadow-black/30\">\n  <div class=\"tool-card-head flex items-center gap-3 border-b border-border bg-surface-alt px-5 py-4 sm:px-6\"><span aria-hidden=\"true\" class=\"icon-badge flex h-10 w-10 flex-none items-center justify-center rounded-xl bg-purple-100 text-purple-600 dark:bg-purple-500/15 dark:text-purple-400\"><svg class=\"icon h-5 w-5\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M4 12h16\"/><circle cx=\"8\" cy=\"12\" r=\"1.5\"/><circle cx=\"16\" cy=\"12\" r=\"1.5\"/></svg></span><div class=\"min-w-0\"><h1 class=\"text-base font-bold leading-snug text-text sm:text-lg\">{{H1}}</h1><p class=\"mt-0.5 truncate text-xs text-text-muted sm:text-sm\">{{HINT}}</p></div></div>\n  <div class=\"tool-card-body flex flex-1 flex-col p-5 sm:p-6\">\n    <div class=\"calc-row flex flex-wrap gap-4\">\n      <div class=\"calc-field mb-4 flex min-w-[140px] flex-1 flex-col gap-1.5\">\n        <label for=\"pp_percent_a\" class=\"text-xs font-semibold uppercase tracking-wide text-text-muted\">Percentage A</label>\n        <div class=\"input-row flex items-center gap-2.5\"><input type=\"number\" id=\"pp_percent_a\" step=\"any\" placeholder=\"e.g. 20\" oninput=\"calculate()\" class=\"w-full flex-1 rounded-xl border border-border bg-surface-alt px-4 py-3 font-mono text-base text-text shadow-sm transition duration-150 placeholder:text-text-muted hover:border-border-strong focus:border-purple-500 focus:outline-none focus:ring-4 focus:ring-purple-500/15 dark:focus:border-purple-400 dark:focus:ring-purple-400/15\"><span class=\"unit flex-none rounded-lg bg-purple-50 px-3 py-1.5 text-sm font-bold text-purple-700 dark:bg-purple-500/15 dark:text-purple-300\">%</span></div>\n      </div>\n      <div class=\"calc-field mb-4 flex min-w-[140px] flex-1 flex-col gap-1.5\">\n        <label for=\"pp_percent_b\" class=\"text-xs font-semibold uppercase tracking-wide text-text-muted\">Percentage B</label>\n        <div class=\"input-row flex items-center gap-2.5\"><input type=\"number\" id=\"pp_percent_b\" step=\"any\" placeholder=\"e.g. 25\" oninput=\"calculate()\" class=\"w-full flex-1 rounded-xl border border-border bg-surface-alt px-4 py-3 font-mono text-base text-text shadow-sm transition duration-150 placeholder:text-text-muted hover:border-border-strong focus:border-purple-500 focus:outline-none focus:ring-4 focus:ring-purple-500/15 dark:focus:border-purple-400 dark:focus:ring-purple-400/15\"><span class=\"unit flex-none rounded-lg bg-purple-50 px-3 py-1.5 text-sm font-bold text-purple-700 dark:bg-purple-500/15 dark:text-purple-300\">%</span></div>\n      </div>\n    </div>\n    <div class=\"calc-results mt-auto space-y-2.5 rounded-xl border border-purple-100 bg-purple-50/60 p-4 dark:border-purple-500/20 dark:bg-purple-500/[0.06]\">\n      <div class=\"calc-result-row flex items-baseline justify-between gap-4\"><span class=\"label text-xs font-semibold uppercase tracking-wide text-text-muted\">Relative Change:</span><output class=\"value font-mono text-sm text-text-secondary\" for=\"pp_percent_a pp_percent_b\" id=\"relative_change\">–</output></div>\n      <div class=\"calc-result-row primary mt-1 flex items-center justify-between gap-4 border-t border-purple-200/70 pt-3 dark:border-purple-500/20\"><span class=\"label text-sm font-semibold text-text-secondary\">Point Difference:</span><output class=\"value text-3xl font-extrabold tracking-tight text-purple-600 dark:text-purple-400\" for=\"pp_percent_a pp_percent_b\" id=\"result\">–</output></div>\n    </div>\n    <p class=\"calc-formula mt-3 text-center font-mono text-xs text-text-muted/80\" id=\"formula_display\"></p>\n  </div>\n</div>"
  },
  "script": "function calculate(){const a=parseFloat(document.getElementById('pp_percent_a').value),b=parseFloat(document.getElementById('pp_percent_b').value),r=document.getElementById('result'),f=document.getElementById('formula_display'),rc=document.getElementById('relative_change');if(!isNaN(a)&&!isNaN(b)){const diff=b-a;r.textContent=formatNumber(diff)+' pp';if(rc)rc.textContent=a!==0?formatNumber((diff/a)*100)+'%':'–';if(f)f.textContent=b+'% − '+a+'% = '+formatNumber(diff)+' pp'}else{r.textContent='–';if(rc)rc.textContent='–';if(f)f.textContent=''}}\nfunction formatNumber(n){return Number.isInteger(n)?n.toString():parseFloat(n.toFixed(2)).toString()}",
  "content_html": "",
  "faq": [],
  "hint": "Enter two percentages to get the difference in percentage points.",
  "long_tail_anchor": "Percentage Point Calculator – Percentage Points vs Percentage Change"
}