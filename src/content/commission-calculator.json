  "meta_description": "Free commission calculator. Enter your sales amount and commission rate to instantly calculate the commission you've earned.",
  "h1": "Commission Calculator",
  "subtitle": "Enter your <strong>sales amount</strong> and <strong>commission rate</strong>, and this <strong>commission calculator</strong> instantly works out the <strong>commission you've earned</strong>.",
  "card": {
    "layout": "raw",
    "fields_html": "<div class=\"tool-card flex h-full flex-col rounded-2xl border border-border bg-surface shadow-sm shadow-black/5 dark:shadow-black/30\">\n  <div class=\"tool-card-head flex items-center gap-3 border-b border-border bg-surface-alt px-5 py-4 sm:px-6\"><span aria-hidden=\"true\" class=\"icon-badge flex h-10 w-10 flex-none items-center justify-center rounded-xl bg-sky-100 text-sky-600 dark:bg-sky-500/15 dark:text-sky-400\"><svg class=\"icon h-5 w-5\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M4 7h16v13H4V7Z\"/><path d=\"M9 7V5a2 2 0 0 1 2-2h2a2 2 0 0 1 2 2v2\"/><path d=\"M4 13h16\"/></svg></span><div class=\"min-w-0\"><h1 class=\"text-base font-bold leading-snug text-text sm:text-lg\">{{H1}}</h1><p class=\"mt-0.5 truncate text-xs text-text-muted sm:text-sm\">{{HINT}}</p></div></div>\n  <div class=\"tool-card-body flex flex-1 flex-col p-5 sm:p-6\">\n    <div class=\"calc-row flex flex-wrap gap-4\">\n      <div class=\"calc-field mb-4 flex min-w-[140px] flex-1 flex-col gap-1.5\"><label for=\"sales_amount\" class=\"text-xs font-semibold uppercase tracking-wide text-text-muted\">Sales Amount ($)</label><input type=\"number\" id=\"sales_amount\" step=\"any\" placeholder=\"e.g. 5000\" oninput=\"calculate()\" class=\"w-full rounded-xl border border-border bg-surface-alt px-4 py-3 font-mono text-base text-text shadow-sm transition duration-150 placeholder:text-text-muted hover:border-border-strong focus:border-sky-500 focus:outline-none focus:ring-4 focus:ring-sky-500/15 dark:focus:border-sky-400 dark:focus:ring-sky-400/15\"></div>\n      <div class=\"calc-field mb-4 flex min-w-[140px] flex-1 flex-col gap-1.5\">\n        <label for=\"commission_rate\" class=\"text-xs font-semibold uppercase tracking-wide text-text-muted\">Commission Rate</label>\n        <div class=\"input-row flex items-center gap-2.5\"><input type=\"number\" id=\"commission_rate\" step=\"any\" placeholder=\"e.g. 10\" oninput=\"calculate()\" class=\"w-full flex-1 rounded-xl border border-border bg-surface-alt px-4 py-3 font-mono text-base text-text shadow-sm transition duration-150 placeholder:text-text-muted hover:border-border-strong focus:border-sky-500 focus:outline-none focus:ring-4 focus:ring-sky-500/15 dark:focus:border-sky-400 dark:focus:ring-sky-400/15\"><span class=\"unit flex-none rounded-lg bg-sky-50 px-3 py-1.5 text-sm font-bold text-sky-700 dark:bg-sky-500/15 dark:text-sky-300\">%</span></div>\n      </div>\n    </div>\n    <div class=\"calc-results mt-auto space-y-2.5 rounded-xl border border-sky-100 bg-sky-50/60 p-4 dark:border-sky-500/20 dark:bg-sky-500/[0.06]\">\n      <div class=\"calc-result-row primary flex items-center justify-between gap-4\"><span class=\"label text-sm font-semibold text-text-secondary\">Commission Earned:</span><output class=\"value text-3xl font-extrabold tracking-tight text-sky-600 dark:text-sky-400\" for=\"sales_amount commission_rate\" id=\"result\">–</output></div>\n    </div>\n    <p class=\"calc-formula mt-3 text-center font-mono text-xs text-text-muted/80\" id=\"formula_display\"></p>\n  </div>\n</div>"
  },
  "script": "function calculate(){const sales=parseFloat(document.getElementById('sales_amount').value),rate=parseFloat(document.getElementById('commission_rate').value),r=document.getElementById('result'),f=document.getElementById('formula_display');if(!isNaN(sales)&&!isNaN(rate)&&sales>=0&&rate>=0){const commission=sales*(rate/100);r.textContent='$'+formatNumber(commission);if(f)f.textContent='$'+sales+' × '+rate+'% = $'+formatNumber(commission)}else{r.textContent='–';if(f)f.textContent=''}}\nfunction formatNumber(n){return Number.isInteger(n)?n.toString():parseFloat(n.toFixed(2)).toString()}",
  "content_html": "",
  "faq": [],
  "hint": "Enter sales amount and commission rate to get commission earned."
}
