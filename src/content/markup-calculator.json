  "subtitle": "Enter the <strong>cost price</strong> and your desired <strong>markup percentage</strong>, and this <strong>markup calculator</strong> instantly works out the <strong>selling price</strong> you should charge.",
  "card": {
    "layout": "raw",
    "fields_html": "<div class=\"tool-card flex h-full flex-col rounded-2xl border border-border bg-surface shadow-sm shadow-black/5 dark:shadow-black/30\">\n  <div class=\"tool-card-head flex items-center gap-3 border-b border-border bg-surface-alt px-5 py-4 sm:px-6\"><span aria-hidden=\"true\" class=\"icon-badge flex h-10 w-10 flex-none items-center justify-center rounded-xl bg-violet-100 text-violet-600 dark:bg-violet-500/15 dark:text-violet-400\"><svg class=\"icon h-5 w-5\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M3 3h8l10 10-8 8L3 11V3Z\"/><path d=\"M15 5v4m-2-2h4\"/></svg></span><div class=\"min-w-0\"><h1 class=\"text-base font-bold leading-snug text-text sm:text-lg\">{{H1}}</h1><p class=\"mt-0.5 truncate text-xs text-text-muted sm:text-sm\">{{HINT}}</p></div></div>\n  <div class=\"tool-card-body flex flex-1 flex-col p-5 sm:p-6\">\n    <div class=\"calc-row flex flex-wrap gap-4\">\n      <div class=\"calc-field mb-4 flex min-w-[140px] flex-1 flex-col gap-1.5\"><label for=\"mk_cost_price\" class=\"text-xs font-semibold uppercase tracking-wide text-text-muted\">Cost Price ($)</label><input type=\"number\" id=\"mk_cost_price\" step=\"any\" placeholder=\"e.g. 40\" oninput=\"calculate()\" class=\"w-full rounded-xl border border-border bg-surface-alt px-4 py-3 font-mono text-base text-text shadow-sm transition duration-150 placeholder:text-text-muted hover:border-border-strong focus:border-violet-500 focus:outline-none focus:ring-4 focus:ring-violet-500/15 dark:focus:border-violet-400 dark:focus:ring-violet-400/15\"></div>\n      <div class=\"calc-field mb-4 flex min-w-[140px] flex-1 flex-col gap-1.5\">\n        <label for=\"mk_markup_percent\" class=\"text-xs font-semibold uppercase tracking-wide text-text-muted\">Markup</label>\n        <div class=\"input-row flex items-center gap-2.5\"><input type=\"number\" id=\"mk_markup_percent\" step=\"any\" placeholder=\"e.g. 30\" oninput=\"calculate()\" class=\"w-full flex-1 rounded-xl border border-border bg-surface-alt px-4 py-3 font-mono text-base text-text shadow-sm transition duration-150 placeholder:text-text-muted hover:border-border-strong focus:border-violet-500 focus:outline-none focus:ring-4 focus:ring-violet-500/15 dark:focus:border-violet-400 dark:focus:ring-violet-400/15\"><span class=\"unit flex-none rounded-lg bg-violet-50 px-3 py-1.5 text-sm font-bold text-violet-700 dark:bg-violet-500/15 dark:text-violet-300\">%</span></div>\n      </div>\n    </div>\n    <div class=\"calc-results mt-auto space-y-2.5 rounded-xl border border-violet-100 bg-violet-50/60 p-4 dark:border-violet-500/20 dark:bg-violet-500/[0.06]\">\n      <div class=\"calc-result-row flex items-baseline justify-between gap-4\"><span class=\"label text-xs font-semibold uppercase tracking-wide text-text-muted\">Markup Amount:</span><output class=\"value font-mono text-sm text-text-secondary\" for=\"mk_cost_price mk_markup_percent\" id=\"markup_amount\">–</output></div>\n      <div class=\"calc-result-row primary mt-1 flex items-center justify-between gap-4 border-t border-violet-200/70 pt-3 dark:border-violet-500/20\"><span class=\"label text-sm font-semibold text-text-secondary\">Selling Price:</span><output class=\"value text-3xl font-extrabold tracking-tight text-violet-600 dark:text-violet-400\" for=\"mk_cost_price mk_markup_percent\" id=\"result\">–</output></div>\n    </div>\n    <p class=\"calc-formula mt-3 text-center font-mono text-xs text-text-muted/80\" id=\"formula_display\"></p>\n  </div>\n</div>"
  },
  "script": "function calculate(){const cost=parseFloat(document.getElementById('mk_cost_price').value),markup=parseFloat(document.getElementById('mk_markup_percent').value),r=document.getElementById('result'),f=document.getElementById('formula_display'),ma=document.getElementById('markup_amount');if(!isNaN(cost)&&!isNaN(markup)&&cost>=0&&markup>=0){const markupAmt=cost*(markup/100),sp=cost+markupAmt;r.textContent='$'+formatNumber(sp);if(ma)ma.textContent='$'+formatNumber(markupAmt);if(f)f.textContent='$'+cost+' + ('+markup+'% × $'+cost+') = $'+formatNumber(sp)}else{r.textContent='–';if(ma)ma.textContent='–';if(f)f.textContent=''}}\nfunction formatNumber(n){return Number.isInteger(n)?n.toString():parseFloat(n.toFixed(2)).toString()}",
  "content_html": "",
  "faq": [],
  "hint": "Enter cost price and markup % to get the selling price."
}
