  "meta_description": "Free baker's percentage calculator. Enter flour weight and ingredient weight to instantly calculate the ingredient's baker's percentage.",
  "h1": "Baker's Percentage Calculator",
  "subtitle": "Enter your <strong>flour weight</strong> and an <strong>ingredient weight</strong>, and this <strong>baker's percentage calculator</strong> instantly works out that ingredient's <strong>baker's percentage</strong> — every ingredient expressed relative to flour.",
  "card": {
    "layout": "raw",
    "fields_html": "<div class=\"tool-card flex h-full flex-col rounded-2xl border border-border bg-surface shadow-sm shadow-black/5 dark:shadow-black/30\">\n  <div class=\"tool-card-head flex items-center gap-3 border-b border-border bg-surface-alt px-5 py-4 sm:px-6\"><span aria-hidden=\"true\" class=\"icon-badge flex h-10 w-10 flex-none items-center justify-center rounded-xl bg-orange-100 text-orange-600 dark:bg-orange-500/15 dark:text-orange-400\"><svg class=\"icon h-5 w-5\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M12 3c-3 3-5 5-5 8a5 5 0 0 0 10 0c0-3-2-5-5-8Z\"/><path d=\"M7 14c-1 2-1 4 0 6M17 14c1 2 1 4 0 6\"/></svg></span><div class=\"min-w-0\"><h1 class=\"text-base font-bold leading-snug text-text sm:text-lg\">{{H1}}</h1><p class=\"mt-0.5 truncate text-xs text-text-muted sm:text-sm\">{{HINT}}</p></div></div>\n  <div class=\"tool-card-body flex flex-1 flex-col p-5 sm:p-6\">\n    <div class=\"calc-row flex flex-wrap gap-4\">\n      <div class=\"calc-field mb-4 flex min-w-[140px] flex-1 flex-col gap-1.5\"><label for=\"flour_weight\" class=\"text-xs font-semibold uppercase tracking-wide text-text-muted\">Flour Weight (g)</label><input type=\"number\" id=\"flour_weight\" step=\"any\" placeholder=\"e.g. 500\" oninput=\"calculate()\" class=\"w-full rounded-xl border border-border bg-surface-alt px-4 py-3 font-mono text-base text-text shadow-sm transition duration-150 placeholder:text-text-muted hover:border-border-strong focus:border-orange-500 focus:outline-none focus:ring-4 focus:ring-orange-500/15 dark:focus:border-orange-400 dark:focus:ring-orange-400/15\"></div>\n      <div class=\"calc-field mb-4 flex min-w-[140px] flex-1 flex-col gap-1.5\"><label for=\"ingredient_weight\" class=\"text-xs font-semibold uppercase tracking-wide text-text-muted\">Ingredient Weight (g)</label><input type=\"number\" id=\"ingredient_weight\" step=\"any\" placeholder=\"e.g. 350\" oninput=\"calculate()\" class=\"w-full rounded-xl border border-border bg-surface-alt px-4 py-3 font-mono text-base text-text shadow-sm transition duration-150 placeholder:text-text-muted hover:border-border-strong focus:border-orange-500 focus:outline-none focus:ring-4 focus:ring-orange-500/15 dark:focus:border-orange-400 dark:focus:ring-orange-400/15\"></div>\n    </div>\n    <div class=\"calc-results mt-auto space-y-2.5 rounded-xl border border-orange-100 bg-orange-50/60 p-4 dark:border-orange-500/20 dark:bg-orange-500/[0.06]\">\n      <div class=\"calc-result-row primary flex items-center justify-between gap-4\"><span class=\"label text-sm font-semibold text-text-secondary\">Baker's Percentage:</span><output class=\"value text-3xl font-extrabold tracking-tight text-orange-600 dark:text-orange-400\" for=\"flour_weight ingredient_weight\" id=\"result\">–</output></div>\n    </div>\n    <p class=\"calc-formula mt-3 text-center font-mono text-xs text-text-muted/80\" id=\"formula_display\"></p>\n  </div>\n</div>"
  },
  "script": "function calculate(){const flour=parseFloat(document.getElementById('flour_weight').value),ing=parseFloat(document.getElementById('ingredient_weight').value),r=document.getElementById('result'),f=document.getElementById('formula_display');if(!isNaN(flour)&&!isNaN(ing)&&flour>0&&ing>=0){const pct=(ing/flour)*100;r.textContent=formatNumber(pct)+'%';if(f)f.textContent=ing+'g ÷ '+flour+'g × 100 = '+formatNumber(pct)+'%'}else{r.textContent='–';if(f)f.textContent=''}}\nfunction formatNumber(n){return Number.isInteger(n)?n.toString():parseFloat(n.toFixed(2)).toString()}",
  "content_html": "",
  "faq": [],
  "hint": "Enter flour weight and ingredient weight to get the baker's percentage."
}
