    "fields_html": "<div class=\"tool-card flex h-full flex-col rounded-2xl border border-border bg-surface shadow-sm shadow-black/5 dark:shadow-black/30\">\n  <div class=\"tool-card-head flex items-center gap-3 border-b border-border bg-surface-alt px-5 py-4 sm:px-6\"><span aria-hidden=\"true\" class=\"icon-badge flex h-10 w-10 flex-none items-center justify-center rounded-xl bg-red-100 text-red-600 dark:bg-red-500/15 dark:text-red-400\"><svg class=\"icon h-5 w-5\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M8 21h8M9 21v-6a3 3 0 0 1 3-3 3 3 0 0 1 3 3v6\"/><path d=\"M7 9a5 5 0 0 1 10 0c1.5 0 2 1 2 2s-1 2-2 2H7c-1 0-2-1-2-2s.5-2 2-2Z\"/></svg></span><div class=\"min-w-0\"><h1 class=\"text-base font-bold leading-snug text-text sm:text-lg\">{{H1}}</h1><p class=\"mt-0.5 truncate text-xs text-text-muted sm:text-sm\">{{HINT}}</p></div></div>\n  <div class=\"tool-card-body flex flex-1 flex-col p-5 sm:p-6\">\n    <div class=\"calc-row flex flex-wrap gap-4\">\n      <div class=\"calc-field mb-4 flex min-w-[140px] flex-1 flex-col gap-1.5\"><label for=\"ingredient_cost\" class=\"text-xs font-semibold uppercase tracking-wide text-text-muted\">Ingredient Cost ($)</label><input type=\"number\" id=\"ingredient_cost\" step=\"any\" placeholder=\"e.g. 3.50\" oninput=\"calculate()\" class=\"w-full rounded-xl border border-border bg-surface-alt px-4 py-3 font-mono text-base text-text shadow-sm transition duration-150 placeholder:text-text-muted hover:border-border-strong focus:border-red-500 focus:outline-none focus:ring-4 focus:ring-red-500/15 dark:focus:border-red-400 dark:focus:ring-red-400/15\"></div>\n      <div class=\"calc-field mb-4 flex min-w-[140px] flex-1 flex-col gap-1.5\"><label for=\"menu_price\" class=\"text-xs font-semibold uppercase tracking-wide text-text-muted\">Menu Price ($)</label><input type=\"number\" id=\"menu_price\" step=\"any\" placeholder=\"e.g. 14\" oninput=\"calculate()\" class=\"w-full rounded-xl border border-border bg-surface-alt px-4 py-3 font-mono text-base text-text shadow-sm transition duration-150 placeholder:text-text-muted hover:border-border-strong focus:border-red-500 focus:outline-none focus:ring-4 focus:ring-red-500/15 dark:focus:border-red-400 dark:focus:ring-red-400/15\"></div>\n    </div>\n    <div class=\"calc-results mt-auto space-y-2.5 rounded-xl border border-red-100 bg-red-50/60 p-4 dark:border-red-500/20 dark:bg-red-500/[0.06]\">\n      <div class=\"calc-result-row primary flex items-center justify-between gap-4\"><span class=\"label text-sm font-semibold text-text-secondary\">Food Cost Percentage:</span><output class=\"value text-3xl font-extrabold tracking-tight text-red-600 dark:text-red-400\" for=\"ingredient_cost menu_price\" id=\"result\">–</output></div>\n    </div>\n    <p class=\"calc-formula mt-3 text-center font-mono text-xs text-text-muted/80\" id=\"formula_display\"></p>\n  </div>\n</div>"
  },
  "script": "function calculate(){const cost=parseFloat(document.getElementById('ingredient_cost').value),price=parseFloat(document.getElementById('menu_price').value),r=document.getElementById('result'),f=document.getElementById('formula_display');if(!isNaN(cost)&&!isNaN(price)&&price>0&&cost>=0){const pct=(cost/price)*100;r.textContent=formatNumber(pct)+'%';if(f)f.textContent='$'+cost+' ÷ $'+price+' × 100 = '+formatNumber(pct)+'%'}else{r.textContent='–';if(f)f.textContent=''}}\nfunction formatNumber(n){return Number.isInteger(n)?n.toString():parseFloat(n.toFixed(2)).toString()}",
