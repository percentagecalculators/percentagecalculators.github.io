  "subtitle": "Enter your <strong>bill amount</strong>, <strong>tip percentage</strong>, and <strong>number of people</strong>, and this <strong>tip calculator</strong> instantly works out the <strong>tip</strong>, the <strong>total</strong>, and how much <strong>each person owes</strong>.",
  "card": {
    "layout": "raw",
    "fields_html": "<div class=\"tool-card flex h-full flex-col rounded-2xl border border-border bg-surface shadow-sm shadow-black/5 dark:shadow-black/30\">\n  <div class=\"tool-card-head flex items-center gap-3 border-b border-border bg-surface-alt px-5 py-4 sm:px-6\"><span aria-hidden=\"true\" class=\"icon-badge flex h-10 w-10 flex-none items-center justify-center rounded-xl bg-green-100 text-green-600 dark:bg-green-500/15 dark:text-green-400\"><svg class=\"icon h-5 w-5\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M6 2h12v20l-3-2-3 2-3-2-3 2V2Z\"/><path d=\"M9 7h6M9 11h6\"/></svg></span><div class=\"min-w-0\"><h1 class=\"text-base font-bold leading-snug text-text sm:text-lg\">{{H1}}</h1><p class=\"mt-0.5 truncate text-xs text-text-muted sm:text-sm\">{{HINT}}</p></div></div>\n  <div class=\"tool-card-body flex flex-1 flex-col p-5 sm:p-6\">\n    <div class=\"calc-row flex flex-wrap gap-4\">\n      <div class=\"calc-field mb-4 flex min-w-[140px] flex-1 flex-col gap-1.5\"><label for=\"bill_amount\" class=\"text-xs font-semibold uppercase tracking-wide text-text-muted\">Bill Amount ($)</label><input type=\"number\" id=\"bill_amount\" step=\"any\" placeholder=\"e.g. 80\" oninput=\"calculate()\" class=\"w-full rounded-xl border border-border bg-surface-alt px-4 py-3 font-mono text-base text-text shadow-sm transition duration-150 placeholder:text-text-muted hover:border-border-strong focus:border-green-500 focus:outline-none focus:ring-4 focus:ring-green-500/15 dark:focus:border-green-400 dark:focus:ring-green-400/15\"></div>\n      <div class=\"calc-field mb-4 flex min-w-[140px] flex-1 flex-col gap-1.5\">\n        <label for=\"tip_percent\" class=\"text-xs font-semibold uppercase tracking-wide text-text-muted\">Tip</label>\n        <div class=\"input-row flex items-center gap-2.5\"><input type=\"number\" id=\"tip_percent\" step=\"any\" placeholder=\"e.g. 18\" oninput=\"calculate()\" class=\"w-full flex-1 rounded-xl border border-border bg-surface-alt px-4 py-3 font-mono text-base text-text shadow-sm transition duration-150 placeholder:text-text-muted hover:border-border-strong focus:border-green-500 focus:outline-none focus:ring-4 focus:ring-green-500/15 dark:focus:border-green-400 dark:focus:ring-green-400/15\"><span class=\"unit flex-none rounded-lg bg-green-50 px-3 py-1.5 text-sm font-bold text-green-700 dark:bg-green-500/15 dark:text-green-300\">%</span></div>\n      </div>\n      <div class=\"calc-field mb-4 flex min-w-[140px] flex-1 flex-col gap-1.5\"><label for=\"split_people\" class=\"text-xs font-semibold uppercase tracking-wide text-text-muted\">Split Between</label><input type=\"number\" id=\"split_people\" step=\"1\" min=\"1\" placeholder=\"e.g. 4\" oninput=\"calculate()\" class=\"w-full rounded-xl border border-border bg-surface-alt px-4 py-3 font-mono text-base text-text shadow-sm transition duration-150 placeholder:text-text-muted hover:border-border-strong focus:border-green-500 focus:outline-none focus:ring-4 focus:ring-green-500/15 dark:focus:border-green-400 dark:focus:ring-green-400/15\"></div>\n    </div>\n    <div class=\"calc-results mt-auto space-y-2.5 rounded-xl border border-green-100 bg-green-50/60 p-4 dark:border-green-500/20 dark:bg-green-500/[0.06]\">\n      <div class=\"calc-result-row flex items-baseline justify-between gap-4\"><span class=\"label text-xs font-semibold uppercase tracking-wide text-text-muted\">Tip Amount:</span><output class=\"value font-mono text-sm text-text-secondary\" for=\"bill_amount tip_percent\" id=\"tip_amount\">–</output></div>\n      <div class=\"calc-result-row flex items-baseline justify-between gap-4\"><span class=\"label text-xs font-semibold uppercase tracking-wide text-text-muted\">Total:</span><output class=\"value font-mono text-sm text-text-secondary\" for=\"bill_amount tip_percent\" id=\"total_amount\">–</output></div>\n      <div class=\"calc-result-row primary mt-1 flex items-center justify-between gap-4 border-t border-green-200/70 pt-3 dark:border-green-500/20\"><span class=\"label text-sm font-semibold text-text-secondary\">Per Person:</span><output class=\"value text-3xl font-extrabold tracking-tight text-green-600 dark:text-green-400\" for=\"bill_amount tip_percent split_people\" id=\"result\">–</output></div>\n    </div>\n    <p class=\"calc-formula mt-3 text-center font-mono text-xs text-text-muted/80\" id=\"formula_display\"></p>\n  </div>\n</div>"
  },
  "script": "function calculate(){const bill=parseFloat(document.getElementById('bill_amount').value),tipPct=parseFloat(document.getElementById('tip_percent').value),people=parseFloat(document.getElementById('split_people').value)||1,r=document.getElementById('result'),f=document.getElementById('formula_display'),ta=document.getElementById('tip_amount'),tot=document.getElementById('total_amount');if(!isNaN(bill)&&!isNaN(tipPct)&&bill>=0&&tipPct>=0&&people>0){const tip=bill*(tipPct/100),total=bill+tip,perPerson=total/people;r.textContent='$'+formatNumber(perPerson);if(ta)ta.textContent='$'+formatNumber(tip);if(tot)tot.textContent='$'+formatNumber(total);if(f)f.textContent='($'+bill+' + '+tipPct+'% tip) ÷ '+people+' = $'+formatNumber(perPerson)+'/person'}else{r.textContent='–';if(ta)ta.textContent='–';if(tot)tot.textContent='–';if(f)f.textContent=''}}\nfunction formatNumber(n){return Number.isInteger(n)?n.toString():parseFloat(n.toFixed(2)).toString()}",
  "content_html": "",
  "faq": [],
  "hint": "Enter bill, tip %, and people to split between."
}
