{
  "slug": "percent-solution-calculator",
  "meta_title": "Percent Solution Calculator | Calculate Mass/Volume Concentration %",
  "meta_description": "Free percent solution calculator. Enter the mass of solute and volume of solution to instantly calculate the percent concentration (% w/v).",
  "h1": "Percent Solution Calculator",
  "subtitle": "Enter the <strong>mass of solute</strong> and the <strong>volume of solution</strong>, and this <strong>percent solution calculator</strong> instantly works out the <strong>percent concentration</strong> (% w/v).",
  "card": {
    "layout": "raw",
    "fields_html": "<div class=\"tool-card flex h-full flex-col overflow-hidden rounded-2xl border border-border bg-surface shadow-sm shadow-black/5 dark:shadow-black/30\">\n  <div class=\"tool-card-head flex items-center gap-3 border-b border-border bg-surface-alt px-5 py-4 sm:px-6\"><span aria-hidden=\"true\" class=\"icon-badge flex h-10 w-10 flex-none items-center justify-center rounded-xl bg-cyan-100 text-cyan-600 dark:bg-cyan-500/15 dark:text-cyan-400\"><svg class=\"icon h-5 w-5\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M9 2v6l-5 10a2 2 0 0 0 2 3h12a2 2 0 0 0 2-3L15 8V2\"/><path d=\"M9 2h6M7 14h10\"/></svg></span><div class=\"min-w-0\"><h1 class=\"text-base font-bold leading-snug text-text sm:text-lg\">{{H1}}</h1><p class=\"mt-0.5 truncate text-xs text-text-muted sm:text-sm\">{{HINT}}</p></div></div>\n  <div class=\"tool-card-body flex flex-1 flex-col p-5 sm:p-6\">\n    <div class=\"calc-row flex flex-wrap gap-4\">\n      <div class=\"calc-field mb-4 flex min-w-[140px] flex-1 flex-col gap-1.5\"><label for=\"solute_mass\" class=\"text-xs font-semibold uppercase tracking-wide text-text-muted\">Mass of Solute (g)</label><input type=\"number\" id=\"solute_mass\" step=\"any\" placeholder=\"e.g. 5\" oninput=\"calculate()\" class=\"w-full rounded-xl border border-border bg-surface-alt px-4 py-3 font-mono text-base text-text shadow-sm transition duration-150 placeholder:text-text-muted hover:border-border-strong focus:border-cyan-500 focus:outline-none focus:ring-4 focus:ring-cyan-500/15 dark:focus:border-cyan-400 dark:focus:ring-cyan-400/15\"></div>\n      <div class=\"calc-field mb-4 flex min-w-[140px] flex-1 flex-col gap-1.5\"><label for=\"solution_volume\" class=\"text-xs font-semibold uppercase tracking-wide text-text-muted\">Volume of Solution (mL)</label><input type=\"number\" id=\"solution_volume\" step=\"any\" placeholder=\"e.g. 250\" oninput=\"calculate()\" class=\"w-full rounded-xl border border-border bg-surface-alt px-4 py-3 font-mono text-base text-text shadow-sm transition duration-150 placeholder:text-text-muted hover:border-border-strong focus:border-cyan-500 focus:outline-none focus:ring-4 focus:ring-cyan-500/15 dark:focus:border-cyan-400 dark:focus:ring-cyan-400/15\"></div>\n    </div>\n    <div class=\"calc-results mt-auto space-y-2.5 rounded-xl border border-cyan-100 bg-cyan-50/60 p-4 dark:border-cyan-500/20 dark:bg-cyan-500/[0.06]\">\n      <div class=\"calc-result-row primary flex items-center justify-between gap-4\"><span class=\"label text-sm font-semibold text-text-secondary\">Concentration (% w/v):</span><output class=\"value text-3xl font-extrabold tracking-tight text-cyan-600 dark:text-cyan-400\" for=\"solute_mass solution_volume\" id=\"result\">–</output></div>\n    </div>\n    <p class=\"calc-formula mt-3 text-center font-mono text-xs text-text-muted/80\" id=\"formula_display\"></p>\n  </div>\n</div>"
  },
  "script": "function calculate(){const mass=parseFloat(document.getElementById('solute_mass').value),vol=parseFloat(document.getElementById('solution_volume').value),r=document.getElementById('result'),f=document.getElementById('formula_display');if(!isNaN(mass)&&!isNaN(vol)&&vol>0&&mass>=0){const pct=(mass/vol)*100;r.textContent=formatNumber(pct)+'%';if(f)f.textContent=mass+'g ÷ '+vol+'mL × 100 = '+formatNumber(pct)+'%'}else{r.textContent='–';if(f)f.textContent=''}}\nfunction formatNumber(n){return Number.isInteger(n)?n.toString():parseFloat(n.toFixed(2)).toString()}",
  "content_html": "",
  "faq": [],
  "hint": "Enter mass of solute and volume of solution to get the concentration."
}