  "meta_description": "Free profit margin calculator. Enter cost price and selling price to instantly calculate your profit and profit margin percentage on selling price.",
  "h1": "Profit Margin Calculator",
  "subtitle": "Enter the <strong>cost price</strong> and <strong>selling price</strong>, and this <strong>profit margin calculator</strong> instantly works out your <strong>profit</strong> and the <strong>profit margin</strong> as a percentage of the selling price.",
  "card": {
    "layout": "raw",
    "fields_html": "<div class=\"tool-card flex h-full flex-col overflow-hidden rounded-2xl border border-border bg-surface shadow-sm shadow-black/5 dark:shadow-black/30\">\n  <div class=\"tool-card-head flex items-center gap-3 border-b border-border bg-surface-alt px-5 py-4 sm:px-6\"><span aria-hidden=\"true\" class=\"icon-badge flex h-10 w-10 flex-none items-center justify-center rounded-xl bg-blue-100 text-blue-600 dark:bg-blue-500/15 dark:text-blue-400\"><svg class=\"icon h-5 w-5\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M12 12V3a9 9 0 1 0 9 9h-9Z\"/><path d=\"M12 3a9 9 0 0 1 9 9\"/></svg></span><div class=\"min-w-0\"><h1 class=\"text-base font-bold leading-snug text-text sm:text-lg\">{{H1}}</h1><p class=\"mt-0.5 truncate text-xs text-text-muted sm:text-sm\">{{HINT}}</p></div></div>\n  <div class=\"tool-card-body flex flex-1 flex-col p-5 sm:p-6\">\n    <div class=\"calc-row flex flex-wrap gap-4\">\n      <div class=\"calc-field mb-4 flex min-w-[140px] flex-1 flex-col gap-1.5\"><label for=\"pm_cost_price\" class=\"text-xs font-semibold uppercase tracking-wide text-text-muted\">Cost Price ($)</label><input type=\"number\" id=\"pm_cost_price\" step=\"any\" placeholder=\"e.g. 40\" oninput=\"calculate()\" class=\"w-full rounded-xl border border-border bg-surface-alt px-4 py-3 font-mono text-base text-text shadow-sm transition duration-150 placeholder:text-text-muted hover:border-border-strong focus:border-blue-500 focus:outline-none focus:ring-4 focus:ring-blue-500/15 dark:focus:border-blue-400 dark:focus:ring-blue-400/15\"></div>\n      <div class=\"calc-field mb-4 flex min-w-[140px] flex-1 flex-col gap-1.5\"><label for=\"pm_selling_price\" class=\"text-xs font-semibold uppercase tracking-wide text-text-muted\">Selling Price ($)</label><input type=\"number\" id=\"pm_selling_price\" step=\"any\" placeholder=\"e.g. 55\" oninput=\"calculate()\" class=\"w-full rounded-xl border border-border bg-surface-alt px-4 py-3 font-mono text-base text-text shadow-sm transition duration-150 placeholder:text-text-muted hover:border-border-strong focus:border-blue-500 focus:outline-none focus:ring-4 focus:ring-blue-500/15 dark:focus:border-blue-400 dark:focus:ring-blue-400/15\"></div>\n    </div>\n    <div class=\"calc-results mt-auto space-y-2.5 rounded-xl border border-blue-100 bg-blue-50/60 p-4 dark:border-blue-500/20 dark:bg-blue-500/[0.06]\">\n      <div class=\"calc-result-row flex items-baseline justify-between gap-4\"><span class=\"label text-xs font-semibold uppercase tracking-wide text-text-muted\">Profit:</span><output class=\"value font-mono text-sm text-text-secondary\" for=\"pm_cost_price pm_selling_price\" id=\"pm_profit_amount\">–</output></div>\n      <div class=\"calc-result-row primary mt-1 flex items-center justify-between gap-4 border-t border-blue-200/70 pt-3 dark:border-blue-500/20\"><span class=\"label text-sm font-semibold text-text-secondary\">Profit Margin:</span><output class=\"value text-3xl font-extrabold tracking-tight text-blue-600 dark:text-blue-400\" for=\"pm_cost_price pm_selling_price\" id=\"result\">–</output></div>\n    </div>\n    <p class=\"calc-formula mt-3 text-center font-mono text-xs text-text-muted/80\" id=\"formula_display\"></p>\n  </div>\n</div>"
  },
  "script": "function calculate(){const cp=parseFloat(document.getElementById('pm_cost_price').value),sp=parseFloat(document.getElementById('pm_selling_price').value),r=document.getElementById('result'),f=document.getElementById('formula_display'),pa=document.getElementById('pm_profit_amount');if(!isNaN(cp)&&!isNaN(sp)&&sp>0){const profit=sp-cp,margin=(profit/sp)*100;r.textContent=formatNumber(margin)+'%';if(pa)pa.textContent='$'+formatNumber(profit);if(f)f.textContent='($'+sp+' − $'+cp+') ÷ $'+sp+' × 100 = '+formatNumber(margin)+'%'}else{r.textContent='–';if(pa)pa.textContent='–';if(f)f.textContent=''}}\nfunction formatNumber(n){return Number.isInteger(n)?n.toString():parseFloat(n.toFixed(2)).toString()}",
  "content_html": "",
  "faq": [],
  "hint": "Enter cost price and selling price to get your profit margin.",
  "long_tail_anchor": "Profit Margin Calculator – Margin % on Selling Price"
}