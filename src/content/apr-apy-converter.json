    "fields_html": "<div class=\"tool-card flex h-full flex-col rounded-2xl border border-border bg-surface shadow-sm shadow-black/5 dark:shadow-black/30\">\n  <div class=\"tool-card-head flex items-center gap-3 border-b border-border bg-surface-alt px-5 py-4 sm:px-6\"><span aria-hidden=\"true\" class=\"icon-badge flex h-10 w-10 flex-none items-center justify-center rounded-xl bg-indigo-100 text-indigo-600 dark:bg-indigo-500/15 dark:text-indigo-400\"><svg class=\"icon h-5 w-5\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M7 7h11m0 0-4-4m4 4-4 4\"/><path d=\"M17 17H6m0 0 4-4m-4 4 4 4\"/></svg></span><div class=\"min-w-0\"><h1 class=\"text-base font-bold leading-snug text-text sm:text-lg\">{{H1}}</h1><p class=\"mt-0.5 truncate text-xs text-text-muted sm:text-sm\">{{HINT}}</p></div></div>\n  <div class=\"tool-card-body flex flex-1 flex-col p-5 sm:p-6\">\n    <div class=\"calc-row flex flex-wrap gap-4\">\n      <div class=\"calc-field mb-4 flex min-w-[140px] flex-1 flex-col gap-1.5\">\n        <label for=\"apr_value\" class=\"text-xs font-semibold uppercase tracking-wide text-text-muted\">APR</label>\n        <div class=\"input-row flex items-center gap-2.5\"><input type=\"number\" id=\"apr_value\" step=\"any\" placeholder=\"e.g. 6\" oninput=\"calculate()\" class=\"w-full flex-1 rounded-xl border border-border bg-surface-alt px-4 py-3 font-mono text-base text-text shadow-sm transition duration-150 placeholder:text-text-muted hover:border-border-strong focus:border-indigo-500 focus:outline-none focus:ring-4 focus:ring-indigo-500/15 dark:focus:border-indigo-400 dark:focus:ring-indigo-400/15\"><span class=\"unit flex-none rounded-lg bg-indigo-50 px-3 py-1.5 text-sm font-bold text-indigo-700 dark:bg-indigo-500/15 dark:text-indigo-300\">%</span></div>\n      </div>\n      <div class=\"calc-field mb-4 flex min-w-[140px] flex-1 flex-col gap-1.5\"><label for=\"compounding_periods2\" class=\"text-xs font-semibold uppercase tracking-wide text-text-muted\">Compounding Periods / Year</label><input type=\"number\" id=\"compounding_periods2\" step=\"1\" min=\"1\" placeholder=\"e.g. 12\" oninput=\"calculate()\" class=\"w-full rounded-xl border border-border bg-surface-alt px-4 py-3 font-mono text-base text-text shadow-sm transition duration-150 placeholder:text-text-muted hover:border-border-strong focus:border-indigo-500 focus:outline-none focus:ring-4 focus:ring-indigo-500/15 dark:focus:border-indigo-400 dark:focus:ring-indigo-400/15\"></div>\n    </div>\n    <div class=\"calc-results mt-auto space-y-2.5 rounded-xl border border-indigo-100 bg-indigo-50/60 p-4 dark:border-indigo-500/20 dark:bg-indigo-500/[0.06]\">\n      <div class=\"calc-result-row primary flex items-center justify-between gap-4\"><span class=\"label text-sm font-semibold text-text-secondary\">APY:</span><output class=\"value text-3xl font-extrabold tracking-tight text-indigo-600 dark:text-indigo-400\" for=\"apr_value compounding_periods2\" id=\"result\">–</output></div>\n    </div>\n    <p class=\"calc-formula mt-3 text-center font-mono text-xs text-text-muted/80\" id=\"formula_display\"></p>\n  </div>\n</div>"
  },
  "script": "function calculate(){const apr=parseFloat(document.getElementById('apr_value').value),n=parseFloat(document.getElementById('compounding_periods2').value),r=document.getElementById('result'),f=document.getElementById('formula_display');if(!isNaN(apr)&&!isNaN(n)&&apr>=0&&n>0){const apy=(Math.pow(1+(apr/100)/n,n)-1)*100;r.textContent=formatNumber(apy)+'%';if(f)f.textContent='((1 + '+apr+'%÷'+n+')^'+n+' − 1) × 100 = '+formatNumber(apy)+'%'}else{r.textContent='–';if(f)f.textContent=''}}\nfunction formatNumber(n){return Number.isInteger(n)?n.toString():parseFloat(n.toFixed(3)).toString()}",
  "content_html": "",
  "faq": [],
  "hint": "Enter an APR and compounding periods per year to get the equivalent APY."
}
