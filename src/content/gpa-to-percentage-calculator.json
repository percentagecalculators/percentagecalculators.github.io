  "meta_description": "Free GPA to percentage calculator. Convert your 4.0-scale GPA into an equivalent percentage instantly. Accurate, simple, no sign-up required.",
  "h1": "GPA to Percentage Calculator",
  "subtitle": "Enter your <strong>GPA</strong> on the standard <strong>4.0 scale</strong> and this <strong>GPA to percentage calculator</strong> converts it into an equivalent <strong>percentage</strong> instantly — handy for applications, transcripts, and comparing grading systems.",
  "card": {
    "layout": "raw",
    "fields_html": "<div class=\"tool-card flex h-full flex-col rounded-2xl border border-border bg-surface shadow-sm shadow-black/5 dark:shadow-black/30\">\n  <div class=\"tool-card-head flex items-center gap-3 border-b border-border bg-surface-alt px-5 py-4 sm:px-6\"><span aria-hidden=\"true\" class=\"icon-badge flex h-10 w-10 flex-none items-center justify-center rounded-xl bg-sky-100 text-sky-600 dark:bg-sky-500/15 dark:text-sky-400\"><svg class=\"icon h-5 w-5\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M12 3 2 9l10 6 10-6-10-6Z\"/><path d=\"M6 12v5c0 1.5 2.7 3 6 3s6-1.5 6-3v-5\"/><path d=\"M22 9v6\"/></svg></span><div class=\"min-w-0\"><h1 class=\"text-base font-bold leading-snug text-text sm:text-lg\">{{H1}}</h1><p class=\"mt-0.5 truncate text-xs text-text-muted sm:text-sm\">{{HINT}}</p></div></div>\n  <div class=\"tool-card-body flex flex-1 flex-col p-5 sm:p-6\">\n    <div class=\"calc-field mb-4 flex min-w-[140px] flex-1 flex-col gap-1.5\"><label for=\"gpa_value\" class=\"text-xs font-semibold uppercase tracking-wide text-text-muted\">GPA (4.0 Scale)</label><input type=\"number\" id=\"gpa_value\" step=\"any\" placeholder=\"e.g. 3.5\" oninput=\"calculate()\" class=\"w-full rounded-xl border border-border bg-surface-alt px-4 py-3 font-mono text-base text-text shadow-sm transition duration-150 placeholder:text-text-muted hover:border-border-strong focus:border-sky-500 focus:outline-none focus:ring-4 focus:ring-sky-500/15 dark:focus:border-sky-400 dark:focus:ring-sky-400/15\"></div>\n    <div class=\"calc-results mt-auto space-y-2.5 rounded-xl border border-sky-100 bg-sky-50/60 p-4 dark:border-sky-500/20 dark:bg-sky-500/[0.06]\">\n      <div class=\"calc-result-row primary flex items-center justify-between gap-4\"><span class=\"label text-sm font-semibold text-text-secondary\">Percentage:</span><output class=\"value text-3xl font-extrabold tracking-tight text-sky-600 dark:text-sky-400\" for=\"gpa_value\" id=\"result\">–</output></div>\n    </div>\n    <p class=\"calc-formula mt-3 text-center font-mono text-xs text-text-muted/80\" id=\"formula_display\"></p>\n  </div>\n</div>"
  },
  "script": "function calculate(){const g=parseFloat(document.getElementById('gpa_value').value),r=document.getElementById('result'),f=document.getElementById('formula_display');if(!isNaN(g)&&g>=0){const pct=(g/4)*100;r.textContent=formatNumber(pct)+'%';if(f)f.textContent='('+g+' ÷ 4) × 100 = '+formatNumber(pct)+'%'}else{r.textContent='–';if(f)f.textContent=''}}\nfunction formatNumber(n){return Number.isInteger(n)?n.toString():parseFloat(n.toFixed(2)).toString()}",
