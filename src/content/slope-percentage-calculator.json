  "meta_description": "Free slope percentage calculator. Enter rise and run to instantly calculate the slope percentage and the equivalent angle in degrees.",
  "h1": "Slope Percentage Calculator",
  "subtitle": "Enter the <strong>rise</strong> and <strong>run</strong>, and this <strong>slope percentage calculator</strong> instantly works out the <strong>slope percentage</strong> and the equivalent <strong>angle in degrees</strong>.",
  "card": {
    "layout": "raw",
    "fields_html": "<div class=\"tool-card flex h-full flex-col overflow-hidden rounded-2xl border border-border bg-surface shadow-sm shadow-black/5 dark:shadow-black/30\">\n  <div class=\"tool-card-head flex items-center gap-3 border-b border-border bg-surface-alt px-5 py-4 sm:px-6\"><span aria-hidden=\"true\" class=\"icon-badge flex h-10 w-10 flex-none items-center justify-center rounded-xl bg-orange-100 text-orange-600 dark:bg-orange-500/15 dark:text-orange-400\"><svg class=\"icon h-5 w-5\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M3 20h18L14 6l-4 7-3-3-4 10Z\"/></svg></span><div class=\"min-w-0\"><h1 class=\"text-base font-bold leading-snug text-text sm:text-lg\">{{H1}}</h1><p class=\"mt-0.5 truncate text-xs text-text-muted sm:text-sm\">{{HINT}}</p></div></div>\n  <div class=\"tool-card-body flex flex-1 flex-col p-5 sm:p-6\">\n    <div class=\"calc-row flex flex-wrap gap-4\">\n      <div class=\"calc-field mb-4 flex min-w-[140px] flex-1 flex-col gap-1.5\"><label for=\"slope_rise\" class=\"text-xs font-semibold uppercase tracking-wide text-text-muted\">Rise</label><input type=\"number\" id=\"slope_rise\" step=\"any\" placeholder=\"e.g. 5\" oninput=\"calculate()\" class=\"w-full rounded-xl border border-border bg-surface-alt px-4 py-3 font-mono text-base text-text shadow-sm transition duration-150 placeholder:text-text-muted hover:border-border-strong focus:border-orange-500 focus:outline-none focus:ring-4 focus:ring-orange-500/15 dark:focus:border-orange-400 dark:focus:ring-orange-400/15\"></div>\n      <div class=\"calc-field mb-4 flex min-w-[140px] flex-1 flex-col gap-1.5\"><label for=\"slope_run\" class=\"text-xs font-semibold uppercase tracking-wide text-text-muted\">Run</label><input type=\"number\" id=\"slope_run\" step=\"any\" placeholder=\"e.g. 100\" oninput=\"calculate()\" class=\"w-full rounded-xl border border-border bg-surface-alt px-4 py-3 font-mono text-base text-text shadow-sm transition duration-150 placeholder:text-text-muted hover:border-border-strong focus:border-orange-500 focus:outline-none focus:ring-4 focus:ring-orange-500/15 dark:focus:border-orange-400 dark:focus:ring-orange-400/15\"></div>\n    </div>\n    <div class=\"calc-results mt-auto space-y-2.5 rounded-xl border border-orange-100 bg-orange-50/60 p-4 dark:border-orange-500/20 dark:bg-orange-500/[0.06]\">\n      <div class=\"calc-result-row flex items-baseline justify-between gap-4\"><span class=\"label text-xs font-semibold uppercase tracking-wide text-text-muted\">Angle:</span><output class=\"value font-mono text-sm text-text-secondary\" for=\"slope_rise slope_run\" id=\"slope_angle\">–</output></div>\n      <div class=\"calc-result-row primary mt-1 flex items-center justify-between gap-4 border-t border-orange-200/70 pt-3 dark:border-orange-500/20\"><span class=\"label text-sm font-semibold text-text-secondary\">Slope:</span><output class=\"value text-3xl font-extrabold tracking-tight text-orange-600 dark:text-orange-400\" for=\"slope_rise slope_run\" id=\"result\">–</output></div>\n    </div>\n    <p class=\"calc-formula mt-3 text-center font-mono text-xs text-text-muted/80\" id=\"formula_display\"></p>\n  </div>\n</div>"
  },
  "script": "function calculate(){const rise=parseFloat(document.getElementById('slope_rise').value),run=parseFloat(document.getElementById('slope_run').value),r=document.getElementById('result'),f=document.getElementById('formula_display'),a=document.getElementById('slope_angle');if(!isNaN(rise)&&!isNaN(run)&&run!==0){const pct=(rise/run)*100,angle=Math.atan(rise/run)*(180/Math.PI);r.textContent=formatNumber(pct)+'%';if(a)a.textContent=formatNumber(angle)+'°';if(f)f.textContent=rise+' ÷ '+run+' × 100 = '+formatNumber(pct)+'%'}else{r.textContent='–';if(a)a.textContent='–';if(f)f.textContent=''}}\nfunction formatNumber(n){return Number.isInteger(n)?n.toString():parseFloat(n.toFixed(2)).toString()}",
