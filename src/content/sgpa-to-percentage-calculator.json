  "subtitle": "Enter your <strong>SGPA</strong> and this <strong>SGPA to percentage calculator</strong> applies the standard <strong>SGPA × 9.5</strong> formula used by most Indian universities to give you an equivalent <strong>percentage</strong> instantly.",
  "card": {
    "layout": "raw",
    "fields_html": "<div class=\"tool-card flex h-full flex-col overflow-hidden rounded-2xl border border-border bg-surface shadow-sm shadow-black/5 dark:shadow-black/30\">\n  <div class=\"tool-card-head flex items-center gap-3 border-b border-border bg-surface-alt px-5 py-4 sm:px-6\"><span aria-hidden=\"true\" class=\"icon-badge flex h-10 w-10 flex-none items-center justify-center rounded-xl bg-fuchsia-100 text-fuchsia-600 dark:bg-fuchsia-500/15 dark:text-fuchsia-400\"><svg class=\"icon h-5 w-5\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M4 20V10M10 20V4M16 20v-7M4 20h16\"/></svg></span><div class=\"min-w-0\"><h1 class=\"text-base font-bold leading-snug text-text sm:text-lg\">{{H1}}</h1><p class=\"mt-0.5 truncate text-xs text-text-muted sm:text-sm\">{{HINT}}</p></div></div>\n  <div class=\"tool-card-body flex flex-1 flex-col p-5 sm:p-6\">\n    <div class=\"calc-field mb-4 flex min-w-[140px] flex-1 flex-col gap-1.5\"><label for=\"sgpa_value\" class=\"text-xs font-semibold uppercase tracking-wide text-text-muted\">SGPA (out of 10)</label><input type=\"number\" id=\"sgpa_value\" step=\"any\" placeholder=\"e.g. 7.8\" oninput=\"calculate()\" class=\"w-full rounded-xl border border-border bg-surface-alt px-4 py-3 font-mono text-base text-text shadow-sm transition duration-150 placeholder:text-text-muted hover:border-border-strong focus:border-fuchsia-500 focus:outline-none focus:ring-4 focus:ring-fuchsia-500/15 dark:focus:border-fuchsia-400 dark:focus:ring-fuchsia-400/15\"></div>\n    <div class=\"calc-results mt-auto space-y-2.5 rounded-xl border border-fuchsia-100 bg-fuchsia-50/60 p-4 dark:border-fuchsia-500/20 dark:bg-fuchsia-500/[0.06]\">\n      <div class=\"calc-result-row primary flex items-center justify-between gap-4\"><span class=\"label text-sm font-semibold text-text-secondary\">Percentage:</span><output class=\"value text-3xl font-extrabold tracking-tight text-fuchsia-600 dark:text-fuchsia-400\" for=\"sgpa_value\" id=\"result\">–</output></div>\n    </div>\n    <p class=\"calc-formula mt-3 text-center font-mono text-xs text-text-muted/80\" id=\"formula_display\"></p>\n  </div>\n</div>"
  },
  "script": "function calculate(){const s=parseFloat(document.getElementById('sgpa_value').value),r=document.getElementById('result'),f=document.getElementById('formula_display');if(!isNaN(s)&&s>=0){const pct=s*9.5;r.textContent=formatNumber(pct)+'%';if(f)f.textContent=s+' × 9.5 = '+formatNumber(pct)+'%'}else{r.textContent='–';if(f)f.textContent=''}}\nfunction formatNumber(n){return Number.isInteger(n)?n.toString():parseFloat(n.toFixed(2)).toString()}",
