{
  "slug": "win-loss-percentage-calculator",
  "meta_title": "Win/Loss Percentage Calculator | Calculate Win Rate",
  "meta_description": "Free win/loss percentage calculator. Enter wins, losses, and ties to instantly calculate your win percentage.",
  "h1": "Win/Loss Percentage Calculator",
  "subtitle": "Enter your <strong>wins</strong>, <strong>losses</strong>, and any <strong>ties</strong>, and this <strong>win/loss percentage calculator</strong> instantly works out your <strong>win percentage</strong>.",
  "card": {
    "layout": "raw",
    "fields_html": "<div class=\"tool-card flex h-full flex-col overflow-hidden rounded-2xl border border-border bg-surface shadow-sm shadow-black/5 dark:shadow-black/30\">\n  <div class=\"tool-card-head flex items-center gap-3 border-b border-border bg-surface-alt px-5 py-4 sm:px-6\"><span aria-hidden=\"true\" class=\"icon-badge flex h-10 w-10 flex-none items-center justify-center rounded-xl bg-yellow-100 text-yellow-600 dark:bg-yellow-500/15 dark:text-yellow-400\"><svg class=\"icon h-5 w-5\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M8 4h8v4a4 4 0 0 1-8 0V4Z\"/><path d=\"M6 6H4a2 2 0 0 0 2 4M18 6h2a2 2 0 0 1-2 4M10 14v3m4-3v3M8 21h8\"/></svg></span><div class=\"min-w-0\"><h1 class=\"text-base font-bold leading-snug text-text sm:text-lg\">{{H1}}</h1><p class=\"mt-0.5 truncate text-xs text-text-muted sm:text-sm\">{{HINT}}</p></div></div>\n  <div class=\"tool-card-body flex flex-1 flex-col p-5 sm:p-6\">\n    <div class=\"calc-row flex flex-wrap gap-4\">\n      <div class=\"calc-field mb-4 flex min-w-[140px] flex-1 flex-col gap-1.5\"><label for=\"wl_wins\" class=\"text-xs font-semibold uppercase tracking-wide text-text-muted\">Wins</label><input type=\"number\" id=\"wl_wins\" step=\"any\" placeholder=\"e.g. 18\" oninput=\"calculate()\" class=\"w-full rounded-xl border border-border bg-surface-alt px-4 py-3 font-mono text-base text-text shadow-sm transition duration-150 placeholder:text-text-muted hover:border-border-strong focus:border-yellow-500 focus:outline-none focus:ring-4 focus:ring-yellow-500/15 dark:focus:border-yellow-400 dark:focus:ring-yellow-400/15\"></div>\n      <div class=\"calc-field mb-4 flex min-w-[140px] flex-1 flex-col gap-1.5\"><label for=\"wl_losses\" class=\"text-xs font-semibold uppercase tracking-wide text-text-muted\">Losses</label><input type=\"number\" id=\"wl_losses\" step=\"any\" placeholder=\"e.g. 10\" oninput=\"calculate()\" class=\"w-full rounded-xl border border-border bg-surface-alt px-4 py-3 font-mono text-base text-text shadow-sm transition duration-150 placeholder:text-text-muted hover:border-border-strong focus:border-yellow-500 focus:outline-none focus:ring-4 focus:ring-yellow-500/15 dark:focus:border-yellow-400 dark:focus:ring-yellow-400/15\"></div>\n      <div class=\"calc-field mb-4 flex min-w-[140px] flex-1 flex-col gap-1.5\"><label for=\"wl_ties\" class=\"text-xs font-semibold uppercase tracking-wide text-text-muted\">Ties</label><input type=\"number\" id=\"wl_ties\" step=\"any\" placeholder=\"e.g. 2\" oninput=\"calculate()\" class=\"w-full rounded-xl border border-border bg-surface-alt px-4 py-3 font-mono text-base text-text shadow-sm transition duration-150 placeholder:text-text-muted hover:border-border-strong focus:border-yellow-500 focus:outline-none focus:ring-4 focus:ring-yellow-500/15 dark:focus:border-yellow-400 dark:focus:ring-yellow-400/15\"></div>\n    </div>\n    <div class=\"calc-results mt-auto space-y-2.5 rounded-xl border border-yellow-100 bg-yellow-50/60 p-4 dark:border-yellow-500/20 dark:bg-yellow-500/[0.06]\">\n      <div class=\"calc-result-row flex items-baseline justify-between gap-4\"><span class=\"label text-xs font-semibold uppercase tracking-wide text-text-muted\">Total Games:</span><output class=\"value font-mono text-sm text-text-secondary\" for=\"wl_wins wl_losses wl_ties\" id=\"total_games\">–</output></div>\n      <div class=\"calc-result-row primary mt-1 flex items-center justify-between gap-4 border-t border-yellow-200/70 pt-3 dark:border-yellow-500/20\"><span class=\"label text-sm font-semibold text-text-secondary\">Win Percentage:</span><output class=\"value text-3xl font-extrabold tracking-tight text-yellow-600 dark:text-yellow-400\" for=\"wl_wins wl_losses wl_ties\" id=\"result\">–</output></div>\n    </div>\n    <p class=\"calc-formula mt-3 text-center font-mono text-xs text-text-muted/80\" id=\"formula_display\"></p>\n  </div>\n</div>"
  },
  "script": "function calculate(){const wins=parseFloat(document.getElementById('wl_wins').value),losses=parseFloat(document.getElementById('wl_losses').value),ties=parseFloat(document.getElementById('wl_ties').value)||0,r=document.getElementById('result'),f=document.getElementById('formula_display'),tg=document.getElementById('total_games');if(!isNaN(wins)&&!isNaN(losses)&&wins>=0&&losses>=0){const total=wins+losses+ties;if(total>0){const pct=(wins/total)*100;r.textContent=formatNumber(pct)+'%';if(tg)tg.textContent=formatNumber(total);if(f)f.textContent=wins+' ÷ '+formatNumber(total)+' × 100 = '+formatNumber(pct)+'%'}else{r.textContent='–';if(tg)tg.textContent='0';if(f)f.textContent=''}}else{r.textContent='–';if(tg)tg.textContent='–';if(f)f.textContent=''}}\nfunction formatNumber(n){return Number.isInteger(n)?n.toString():parseFloat(n.toFixed(2)).toString()}",
  "content_html": "",
  "faq": [],
  "hint": "Enter wins, losses, and ties to get your win percentage."
}