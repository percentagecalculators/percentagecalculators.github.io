{
  "slug": "decimal-to-percentage-calculator",
  "meta_title": "Decimal to Percentage Calculator | Convert Decimal to %",
  "meta_description": "Free decimal to percentage calculator. Enter any decimal value to instantly convert it to a percentage.",
  "h1": "Decimal to Percentage Calculator",
  "subtitle": "Enter a <strong>decimal value</strong> and this <strong>decimal to percentage calculator</strong> instantly converts it into a <strong>percentage</strong>.",
  "card": {
    "layout": "raw",
    "fields_html": "<div class=\"tool-card flex h-full flex-col rounded-2xl border border-border bg-surface shadow-sm shadow-black/5 dark:shadow-black/30\">\n  <div class=\"tool-card-head flex items-center gap-3 border-b border-border bg-surface-alt px-5 py-4 sm:px-6\"><span aria-hidden=\"true\" class=\"icon-badge flex h-10 w-10 flex-none items-center justify-center rounded-xl bg-teal-100 text-teal-600 dark:bg-teal-500/15 dark:text-teal-400\"><svg class=\"icon h-5 w-5\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M5 12h-2m18 0h-2\"/><circle cx=\"12\" cy=\"12\" r=\"5\"/></svg></span><div class=\"min-w-0\"><h1 class=\"text-base font-bold leading-snug text-text sm:text-lg\">{{H1}}</h1><p class=\"mt-0.5 truncate text-xs text-text-muted sm:text-sm\">{{HINT}}</p></div></div>\n  <div class=\"tool-card-body flex flex-1 flex-col p-5 sm:p-6\">\n    <div class=\"calc-field mb-4 flex min-w-[140px] flex-1 flex-col gap-1.5\"><label for=\"decimal_value\" class=\"text-xs font-semibold uppercase tracking-wide text-text-muted\">Decimal Value</label><input type=\"number\" id=\"decimal_value\" step=\"any\" placeholder=\"e.g. 0.25\" oninput=\"calculate()\" class=\"w-full rounded-xl border border-border bg-surface-alt px-4 py-3 font-mono text-base text-text shadow-sm transition duration-150 placeholder:text-text-muted hover:border-border-strong focus:border-teal-500 focus:outline-none focus:ring-4 focus:ring-teal-500/15 dark:focus:border-teal-400 dark:focus:ring-teal-400/15\"></div>\n    <div class=\"calc-results mt-auto space-y-2.5 rounded-xl border border-teal-100 bg-teal-50/60 p-4 dark:border-teal-500/20 dark:bg-teal-500/[0.06]\">\n      <div class=\"calc-result-row primary flex items-center justify-between gap-4\"><span class=\"label text-sm font-semibold text-text-secondary\">Percentage:</span><output class=\"value text-3xl font-extrabold tracking-tight text-teal-600 dark:text-teal-400\" for=\"decimal_value\" id=\"result\">–</output></div>\n    </div>\n    <p class=\"calc-formula mt-3 text-center font-mono text-xs text-text-muted/80\" id=\"formula_display\"></p>\n  </div>\n</div>"
  },
  "script": "function calculate(){const d=parseFloat(document.getElementById('decimal_value').value),r=document.getElementById('result'),f=document.getElementById('formula_display');if(!isNaN(d)){const pct=d*100;r.textContent=formatNumber(pct)+'%';if(f)f.textContent=d+' × 100 = '+formatNumber(pct)+'%'}else{r.textContent='–';if(f)f.textContent=''}}\nfunction formatNumber(n){return Number.isInteger(n)?n.toString():parseFloat(n.toFixed(4)).toString()}",
  "content_html": "",
  "faq": [],
  "hint": "Enter a decimal value to get the equivalent percentage."
