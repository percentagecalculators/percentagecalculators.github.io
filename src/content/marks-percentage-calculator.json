  "subtitle": "Enter the <strong>marks obtained</strong> and the <strong>total marks</strong>, and this <strong>marks percentage calculator</strong> instantly works out your <strong>exam percentage</strong> — perfect for report cards, mark sheets, and result checks.",
  "card": {
    "layout": "raw",
    "fields_html": "<div class=\"tool-card flex h-full flex-col overflow-hidden rounded-2xl border border-border bg-surface shadow-sm shadow-black/5 dark:shadow-black/30\">\n  <div class=\"tool-card-head flex items-center gap-3 border-b border-border bg-surface-alt px-5 py-4 sm:px-6\"><span aria-hidden=\"true\" class=\"icon-badge flex h-10 w-10 flex-none items-center justify-center rounded-xl bg-lime-100 text-lime-600 dark:bg-lime-500/15 dark:text-lime-400\"><svg class=\"icon h-5 w-5\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M7 3h8l4 4v14H7V3Z\"/><path d=\"M9 9h6M9 13l1.5 1.5L14 11\"/></svg></span><div class=\"min-w-0\"><h1 class=\"text-base font-bold leading-snug text-text sm:text-lg\">{{H1}}</h1><p class=\"mt-0.5 truncate text-xs text-text-muted sm:text-sm\">{{HINT}}</p></div></div>\n  <div class=\"tool-card-body flex flex-1 flex-col p-5 sm:p-6\">\n    <div class=\"calc-row flex flex-wrap gap-4\">\n      <div class=\"calc-field mb-4 flex min-w-[140px] flex-1 flex-col gap-1.5\"><label for=\"marks_obtained\" class=\"text-xs font-semibold uppercase tracking-wide text-text-muted\">Marks Obtained</label><input type=\"number\" id=\"marks_obtained\" step=\"any\" placeholder=\"e.g. 450\" oninput=\"calculate()\" class=\"w-full rounded-xl border border-border bg-surface-alt px-4 py-3 font-mono text-base text-text shadow-sm transition duration-150 placeholder:text-text-muted hover:border-border-strong focus:border-lime-500 focus:outline-none focus:ring-4 focus:ring-lime-500/15 dark:focus:border-lime-400 dark:focus:ring-lime-400/15\"></div>\n      <div class=\"calc-divider hidden self-center pt-6 text-2xl font-semibold text-text-muted/60 md:block\">/</div>\n      <div class=\"calc-field mb-4 flex min-w-[140px] flex-1 flex-col gap-1.5\"><label for=\"total_marks\" class=\"text-xs font-semibold uppercase tracking-wide text-text-muted\">Total Marks</label><input type=\"number\" id=\"total_marks\" step=\"any\" placeholder=\"e.g. 500\" oninput=\"calculate()\" class=\"w-full rounded-xl border border-border bg-surface-alt px-4 py-3 font-mono text-base text-text shadow-sm transition duration-150 placeholder:text-text-muted hover:border-border-strong focus:border-lime-500 focus:outline-none focus:ring-4 focus:ring-lime-500/15 dark:focus:border-lime-400 dark:focus:ring-lime-400/15\"></div>\n    </div>\n    <div class=\"calc-results mt-auto space-y-2.5 rounded-xl border border-lime-100 bg-lime-50/60 p-4 dark:border-lime-500/20 dark:bg-lime-500/[0.06]\">\n      <div class=\"calc-result-row primary flex items-center justify-between gap-4\"><span class=\"label text-sm font-semibold text-text-secondary\">Percentage:</span><output class=\"value text-3xl font-extrabold tracking-tight text-lime-600 dark:text-lime-400\" for=\"marks_obtained total_marks\" id=\"result\">–</output></div>\n    </div>\n    <p class=\"calc-formula mt-3 text-center font-mono text-xs text-text-muted/80\" id=\"formula_display\"></p>\n  </div>\n</div>"
  },
  "script": "function calculate(){const m=parseFloat(document.getElementById('marks_obtained').value),t=parseFloat(document.getElementById('total_marks').value),r=document.getElementById('result'),f=document.getElementById('formula_display');if(!isNaN(m)&&!isNaN(t)&&m>=0&&t>0){const pct=(m/t)*100;r.textContent=formatNumber(pct)+'%';if(f)f.textContent=m+' ÷ '+t+' × 100 = '+formatNumber(pct)+'%'}else{r.textContent='–';if(f)f.textContent=''}}\nfunction formatNumber(n){return Number.isInteger(n)?n.toString():parseFloat(n.toFixed(2)).toString()}",
  "content_html": "",
  "faq": [],
  "hint": "Enter marks obtained and total marks to get your percentage.",
  "long_tail_anchor": "Marks Percentage Calculator – Exam & Test Score Percentage"
