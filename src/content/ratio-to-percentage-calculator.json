{
  "slug": "ratio-to-percentage-calculator",
  "meta_title": "Ratio to Percentage Calculator | Convert a Ratio to %",
  "meta_description": "Free ratio to percentage calculator. Enter two parts of a ratio to instantly see the total and what percentage the first part represents.",
  "h1": "Ratio to Percentage Calculator",
  "subtitle": "Enter both parts of a <strong>ratio</strong> (like 3 : 4), and this <strong>ratio to percentage calculator</strong> instantly shows the <strong>total</strong> and what <strong>percentage</strong> the first part represents.",
  "card": {
    "layout": "raw",
    "fields_html": "<div class=\"tool-card flex h-full flex-col overflow-hidden rounded-2xl border border-border bg-surface shadow-sm shadow-black/5 dark:shadow-black/30\">\n  <div class=\"tool-card-head flex items-center gap-3 border-b border-border bg-surface-alt px-5 py-4 sm:px-6\"><span aria-hidden=\"true\" class=\"icon-badge flex h-10 w-10 flex-none items-center justify-center rounded-xl bg-amber-100 text-amber-600 dark:bg-amber-500/15 dark:text-amber-400\"><svg class=\"icon h-5 w-5\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M12 3v18M5 7h14M5 7l-2 5h4L5 7Zm14 0-2 5h4l-2-5Z\"/></svg></span><div class=\"min-w-0\"><h1 class=\"text-base font-bold leading-snug text-text sm:text-lg\">{{H1}}</h1><p class=\"mt-0.5 truncate text-xs text-text-muted sm:text-sm\">{{HINT}}</p></div></div>\n  <div class=\"tool-card-body flex flex-1 flex-col p-5 sm:p-6\">\n    <div class=\"calc-row flex flex-wrap gap-4\">\n      <div class=\"calc-field mb-4 flex min-w-[140px] flex-1 flex-col gap-1.5\"><label for=\"ratio_part_a\" class=\"text-xs font-semibold uppercase tracking-wide text-text-muted\">Part A</label><input type=\"number\" id=\"ratio_part_a\" step=\"any\" placeholder=\"e.g. 3\" oninput=\"calculate()\" class=\"w-full rounded-xl border border-border bg-surface-alt px-4 py-3 font-mono text-base text-text shadow-sm transition duration-150 placeholder:text-text-muted hover:border-border-strong focus:border-amber-500 focus:outline-none focus:ring-4 focus:ring-amber-500/15 dark:focus:border-amber-400 dark:focus:ring-amber-400/15\"></div>\n      <div class=\"calc-divider hidden self-center pt-6 text-2xl font-semibold text-text-muted/60 md:block\">:</div>\n      <div class=\"calc-field mb-4 flex min-w-[140px] flex-1 flex-col gap-1.5\"><label for=\"ratio_part_b\" class=\"text-xs font-semibold uppercase tracking-wide text-text-muted\">Part B</label><input type=\"number\" id=\"ratio_part_b\" step=\"any\" placeholder=\"e.g. 4\" oninput=\"calculate()\" class=\"w-full rounded-xl border border-border bg-surface-alt px-4 py-3 font-mono text-base text-text shadow-sm transition duration-150 placeholder:text-text-muted hover:border-border-strong focus:border-amber-500 focus:outline-none focus:ring-4 focus:ring-amber-500/15 dark:focus:border-amber-400 dark:focus:ring-amber-400/15\"></div>\n    </div>\n    <div class=\"calc-results mt-auto space-y-2.5 rounded-xl border border-amber-100 bg-amber-50/60 p-4 dark:border-amber-500/20 dark:bg-amber-500/[0.06]\">\n      <div class=\"calc-result-row flex items-baseline justify-between gap-4\"><span class=\"label text-xs font-semibold uppercase tracking-wide text-text-muted\">Total:</span><output class=\"value font-mono text-sm text-text-secondary\" for=\"ratio_part_a ratio_part_b\" id=\"ratio_total\">–</output></div>\n      <div class=\"calc-result-row primary mt-1 flex items-center justify-between gap-4 border-t border-amber-200/70 pt-3 dark:border-amber-500/20\"><span class=\"label text-sm font-semibold text-text-secondary\">A as % of Total:</span><output class=\"value text-3xl font-extrabold tracking-tight text-amber-600 dark:text-amber-400\" for=\"ratio_part_a ratio_part_b\" id=\"result\">–</output></div>\n    </div>\n    <p class=\"calc-formula mt-3 text-center font-mono text-xs text-text-muted/80\" id=\"formula_display\"></p>\n  </div>\n</div>"
  },
  "script": "function calculate(){const a=parseFloat(document.getElementById('ratio_part_a').value),b=parseFloat(document.getElementById('ratio_part_b').value),r=document.getElementById('result'),f=document.getElementById('formula_display'),t=document.getElementById('ratio_total');if(!isNaN(a)&&!isNaN(b)&&a>=0&&b>=0&&(a+b)>0){const total=a+b,pct=(a/total)*100;r.textContent=formatNumber(pct)+'%';if(t)t.textContent=formatNumber(total);if(f)f.textContent=a+' ÷ ('+a+' + '+b+') × 100 = '+formatNumber(pct)+'%'}else{r.textContent='–';if(t)t.textContent='–';if(f)f.textContent=''}}\nfunction formatNumber(n){return Number.isInteger(n)?n.toString():parseFloat(n.toFixed(2)).toString()}",
  "content_html": "",
  "faq": [],
  "hint": "Enter both parts of a ratio to get the percentage of the total."
}