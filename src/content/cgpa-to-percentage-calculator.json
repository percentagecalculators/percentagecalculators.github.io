{
  "slug": "cgpa-to-percentage-calculator",
  "meta_title": "CGPA to Percentage Calculator | Convert 10-Point CGPA to %",
  "meta_description": "Free CGPA to percentage calculator using the standard 10-point CGPA × 9.5 formula. Convert your CGPA to percentage instantly for college and university records.",
  "h1": "CGPA to Percentage Calculator",
  "subtitle": "Enter your <strong>CGPA</strong> on the standard <strong>10-point scale</strong> and this <strong>CGPA to percentage calculator</strong> applies the widely used <strong>CGPA × 9.5</strong> formula to give you an equivalent <strong>percentage</strong> instantly.",
  "card": {
    "layout": "raw",
    "fields_html": "<div class=\"tool-card flex h-full flex-col rounded-2xl border border-border bg-surface shadow-sm shadow-black/5 dark:shadow-black/30\">\n  <div class=\"tool-card-head flex items-center gap-3 border-b border-border bg-surface-alt px-5 py-4 sm:px-6\"><span aria-hidden=\"true\" class=\"icon-badge flex h-10 w-10 flex-none items-center justify-center rounded-xl bg-purple-100 text-purple-600 dark:bg-purple-500/15 dark:text-purple-400\"><svg class=\"icon h-5 w-5\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M12 15a5 5 0 1 0 0-10 5 5 0 0 0 0 10Z\"/><path d=\"M8.5 13.7 7 21l5-2.5L17 21l-1.5-7.3\"/></svg></span><div class=\"min-w-0\"><h1 class=\"text-base font-bold leading-snug text-text sm:text-lg\">{{H1}}</h1><p class=\"mt-0.5 truncate text-xs text-text-muted sm:text-sm\">{{HINT}}</p></div></div>\n  <div class=\"tool-card-body flex flex-1 flex-col p-5 sm:p-6\">\n    <div class=\"calc-field mb-4 flex min-w-[140px] flex-1 flex-col gap-1.5\"><label for=\"cgpa_value\" class=\"text-xs font-semibold uppercase tracking-wide text-text-muted\">CGPA (out of 10)</label><input type=\"number\" id=\"cgpa_value\" step=\"any\" placeholder=\"e.g. 8.2\" oninput=\"calculate()\" class=\"w-full rounded-xl border border-border bg-surface-alt px-4 py-3 font-mono text-base text-text shadow-sm transition duration-150 placeholder:text-text-muted hover:border-border-strong focus:border-purple-500 focus:outline-none focus:ring-4 focus:ring-purple-500/15 dark:focus:border-purple-400 dark:focus:ring-purple-400/15\"></div>\n    <div class=\"calc-results mt-auto space-y-2.5 rounded-xl border border-purple-100 bg-purple-50/60 p-4 dark:border-purple-500/20 dark:bg-purple-500/[0.06]\">\n      <div class=\"calc-result-row primary flex items-center justify-between gap-4\"><span class=\"label text-sm font-semibold text-text-secondary\">Percentage:</span><output class=\"value text-3xl font-extrabold tracking-tight text-purple-600 dark:text-purple-400\" for=\"cgpa_value\" id=\"result\">–</output></div>\n    </div>\n    <p class=\"calc-formula mt-3 text-center font-mono text-xs text-text-muted/80\" id=\"formula_display\"></p>\n  </div>\n</div>"
  },
  "script": "function calculate(){const c=parseFloat(document.getElementById('cgpa_value').value),r=document.getElementById('result'),f=document.getElementById('formula_display');if(!isNaN(c)&&c>=0){const pct=c*9.5;r.textContent=formatNumber(pct)+'%';if(f)f.textContent=c+' × 9.5 = '+formatNumber(pct)+'%'}else{r.textContent='–';if(f)f.textContent=''}}\nfunction formatNumber(n){return Number.isInteger(n)?n.toString():parseFloat(n.toFixed(2)).toString()}",
  "content_html": "",
  "faq": [],
  "hint": "Enter your 10-point CGPA to get the equivalent percentage."
}
