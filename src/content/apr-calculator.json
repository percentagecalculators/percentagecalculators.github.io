{
  "slug": "apr-calculator",
  "meta_title": "APR Calculator | Annual Percentage Rate Calculator",
  "meta_description": "Free APR calculator. Convert a periodic interest rate into the Annual Percentage Rate (APR) instantly — the standard way loans and credit cards quote cost.",
  "h1": "APR Calculator",
  "subtitle": "Enter the <strong>periodic interest rate</strong> and the <strong>number of periods per year</strong>, and this <strong>APR calculator</strong> works out the <strong>Annual Percentage Rate</strong> — the standard, non-compounded way lenders quote borrowing costs.",
  "card": {
    "layout": "raw",
    "fields_html": "<div class=\"tool-card flex h-full flex-col rounded-2xl border border-border bg-surface shadow-sm shadow-black/5 dark:shadow-black/30\">\n  <div class=\"tool-card-head flex items-center gap-3 border-b border-border bg-surface-alt px-5 py-4 sm:px-6\"><span aria-hidden=\"true\" class=\"icon-badge flex h-10 w-10 flex-none items-center justify-center rounded-xl bg-cyan-100 text-cyan-600 dark:bg-cyan-500/15 dark:text-cyan-400\"><svg class=\"icon h-5 w-5\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M12 3 2 9h20L12 3Z\"/><path d=\"M4 9v10M9 9v10M15 9v10M20 9v10M2 21h20\"/></svg></span><div class=\"min-w-0\"><h1 class=\"text-base font-bold leading-snug text-text sm:text-lg\">{{H1}}</h1><p class=\"mt-0.5 truncate text-xs text-text-muted sm:text-sm\">{{HINT}}</p></div></div>\n  <div class=\"tool-card-body flex flex-1 flex-col p-5 sm:p-6\">\n    <div class=\"calc-row flex flex-wrap gap-4\">\n      <div class=\"calc-field mb-4 flex min-w-[140px] flex-1 flex-col gap-1.5\">\n        <label for=\"periodic_rate\" class=\"text-xs font-semibold uppercase tracking-wide text-text-muted\">Periodic Interest Rate</label>\n        <div class=\"input-row flex items-center gap-2.5\"><input type=\"number\" id=\"periodic_rate\" step=\"any\" placeholder=\"e.g. 1.5\" oninput=\"calculate()\" class=\"w-full flex-1 rounded-xl border border-border bg-surface-alt px-4 py-3 font-mono text-base text-text shadow-sm transition duration-150 placeholder:text-text-muted hover:border-border-strong focus:border-cyan-500 focus:outline-none focus:ring-4 focus:ring-cyan-500/15 dark:focus:border-cyan-400 dark:focus:ring-cyan-400/15\"><span class=\"unit flex-none rounded-lg bg-cyan-50 px-3 py-1.5 text-sm font-bold text-cyan-700 dark:bg-cyan-500/15 dark:text-cyan-300\">%</span></div>\n      </div>\n      <div class=\"calc-field mb-4 flex min-w-[140px] flex-1 flex-col gap-1.5\"><label for=\"periods_per_year\" class=\"text-xs font-semibold uppercase tracking-wide text-text-muted\">Periods / Year</label><input type=\"number\" id=\"periods_per_year\" step=\"1\" min=\"1\" placeholder=\"e.g. 12\" oninput=\"calculate()\" class=\"w-full rounded-xl border border-border bg-surface-alt px-4 py-3 font-mono text-base text-text shadow-sm transition duration-150 placeholder:text-text-muted hover:border-border-strong focus:border-cyan-500 focus:outline-none focus:ring-4 focus:ring-cyan-500/15 dark:focus:border-cyan-400 dark:focus:ring-cyan-400/15\"></div>\n    </div>\n    <div class=\"calc-results mt-auto space-y-2.5 rounded-xl border border-cyan-100 bg-cyan-50/60 p-4 dark:border-cyan-500/20 dark:bg-cyan-500/[0.06]\">\n      <div class=\"calc-result-row primary flex items-center justify-between gap-4\"><span class=\"label text-sm font-semibold text-text-secondary\">APR:</span><output class=\"value text-3xl font-extrabold tracking-tight text-cyan-600 dark:text-cyan-400\" for=\"periodic_rate periods_per_year\" id=\"result\">–</output></div>\n    </div>\n    <p class=\"calc-formula mt-3 text-center font-mono text-xs text-text-muted/80\" id=\"formula_display\"></p>\n  </div>\n</div>"
  },
  "script": "function calculate(){const rate=parseFloat(document.getElementById('periodic_rate').value),n=parseFloat(document.getElementById('periods_per_year').value),r=document.getElementById('result'),f=document.getElementById('formula_display');if(!isNaN(rate)&&!isNaN(n)&&rate>=0&&n>0){const apr=rate*n;r.textContent=formatNumber(apr)+'%';if(f)f.textContent=rate+'% × '+n+' = '+formatNumber(apr)+'%'}else{r.textContent='–';if(f)f.textContent=''}}\nfunction formatNumber(n){return Number.isInteger(n)?n.toString():parseFloat(n.toFixed(3)).toString()}",
  "content_html": "",
  "faq": [],
  "hint": "Enter the periodic rate and periods per year to get the APR."
}
