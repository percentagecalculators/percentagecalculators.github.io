    "fields_html": "<div class=\"tool-card flex h-full flex-col rounded-2xl border border-border bg-surface shadow-sm shadow-black/5 dark:shadow-black/30\">\n  <div class=\"tool-card-head flex items-center gap-3 border-b border-border bg-surface-alt px-5 py-4 sm:px-6\"><span aria-hidden=\"true\" class=\"icon-badge flex h-10 w-10 flex-none items-center justify-center rounded-xl bg-red-100 text-red-600 dark:bg-red-500/15 dark:text-red-400\"><svg class=\"icon h-5 w-5\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M9 2h6v4l2 3v11a2 2 0 0 1-2 2H9a2 2 0 0 1-2-2V9l2-3V2Z\"/><path d=\"M9 11h6\"/></svg></span><div class=\"min-w-0\"><h1 class=\"text-base font-bold leading-snug text-text sm:text-lg\">{{H1}}</h1><p class=\"mt-0.5 truncate text-xs text-text-muted sm:text-sm\">{{HINT}}</p></div></div>\n  <div class=\"tool-card-body flex flex-1 flex-col p-5 sm:p-6\">\n    <div class=\"calc-field mb-4 flex min-w-[140px] flex-1 flex-col gap-1.5\"><label for=\"proof_value\" class=\"text-xs font-semibold uppercase tracking-wide text-text-muted\">Proof (US)</label><input type=\"number\" id=\"proof_value\" step=\"any\" placeholder=\"e.g. 80\" oninput=\"calculate()\" class=\"w-full rounded-xl border border-border bg-surface-alt px-4 py-3 font-mono text-base text-text shadow-sm transition duration-150 placeholder:text-text-muted hover:border-border-strong focus:border-red-500 focus:outline-none focus:ring-4 focus:ring-red-500/15 dark:focus:border-red-400 dark:focus:ring-red-400/15\"></div>\n    <div class=\"calc-results mt-auto space-y-2.5 rounded-xl border border-red-100 bg-red-50/60 p-4 dark:border-red-500/20 dark:bg-red-500/[0.06]\">\n      <div class=\"calc-result-row primary flex items-center justify-between gap-4\"><span class=\"label text-sm font-semibold text-text-secondary\">ABV:</span><output class=\"value text-3xl font-extrabold tracking-tight text-red-600 dark:text-red-400\" for=\"proof_value\" id=\"result\">–</output></div>\n    </div>\n    <p class=\"calc-formula mt-3 text-center font-mono text-xs text-text-muted/80\" id=\"formula_display\"></p>\n  </div>\n</div>"
  },
  "script": "function calculate(){const proof=parseFloat(document.getElementById('proof_value').value),r=document.getElementById('result'),f=document.getElementById('formula_display');if(!isNaN(proof)&&proof>=0){const abv=proof/2;r.textContent=formatNumber(abv)+'%';if(f)f.textContent=proof+' ÷ 2 = '+formatNumber(abv)+'%'}else{r.textContent='–';if(f)f.textContent=''}}\nfunction formatNumber(n){return Number.isInteger(n)?n.toString():parseFloat(n.toFixed(2)).toString()}",
