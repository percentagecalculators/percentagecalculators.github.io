  "meta_description": "Free loan interest calculator. Enter loan amount, annual rate, and term to instantly calculate your monthly EMI and total interest payable.",
  "h1": "Loan Interest Calculator",
  "subtitle": "Enter the <strong>loan amount</strong>, <strong>annual interest rate</strong>, and <strong>loan term</strong>, and this <strong>loan interest calculator</strong> instantly works out your <strong>monthly EMI</strong> and the <strong>total interest</strong> you'll pay.",
  "card": {
    "layout": "raw",
    "fields_html": "<div class=\"tool-card flex h-full flex-col overflow-hidden rounded-2xl border border-border bg-surface shadow-sm shadow-black/5 dark:shadow-black/30\">\n  <div class=\"tool-card-head flex items-center gap-3 border-b border-border bg-surface-alt px-5 py-4 sm:px-6\"><span aria-hidden=\"true\" class=\"icon-badge flex h-10 w-10 flex-none items-center justify-center rounded-xl bg-red-100 text-red-600 dark:bg-red-500/15 dark:text-red-400\"><svg class=\"icon h-5 w-5\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M4 10 12 3l8 7v10a1 1 0 0 1-1 1h-4v-6H9v6H5a1 1 0 0 1-1-1V10Z\"/></svg></span><div class=\"min-w-0\"><h1 class=\"text-base font-bold leading-snug text-text sm:text-lg\">{{H1}}</h1><p class=\"mt-0.5 truncate text-xs text-text-muted sm:text-sm\">{{HINT}}</p></div></div>\n  <div class=\"tool-card-body flex flex-1 flex-col p-5 sm:p-6\">\n    <div class=\"calc-row flex flex-wrap gap-4\">\n      <div class=\"calc-field mb-4 flex min-w-[140px] flex-1 flex-col gap-1.5\"><label for=\"loan_amount\" class=\"text-xs font-semibold uppercase tracking-wide text-text-muted\">Loan Amount ($)</label><input type=\"number\" id=\"loan_amount\" step=\"any\" placeholder=\"e.g. 20000\" oninput=\"calculate()\" class=\"w-full rounded-xl border border-border bg-surface-alt px-4 py-3 font-mono text-base text-text shadow-sm transition duration-150 placeholder:text-text-muted hover:border-border-strong focus:border-red-500 focus:outline-none focus:ring-4 focus:ring-red-500/15 dark:focus:border-red-400 dark:focus:ring-red-400/15\"></div>\n      <div class=\"calc-field mb-4 flex min-w-[140px] flex-1 flex-col gap-1.5\">\n        <label for=\"loan_rate\" class=\"text-xs font-semibold uppercase tracking-wide text-text-muted\">Annual Rate</label>\n        <div class=\"input-row flex items-center gap-2.5\"><input type=\"number\" id=\"loan_rate\" step=\"any\" placeholder=\"e.g. 7.5\" oninput=\"calculate()\" class=\"w-full flex-1 rounded-xl border border-border bg-surface-alt px-4 py-3 font-mono text-base text-text shadow-sm transition duration-150 placeholder:text-text-muted hover:border-border-strong focus:border-red-500 focus:outline-none focus:ring-4 focus:ring-red-500/15 dark:focus:border-red-400 dark:focus:ring-red-400/15\"><span class=\"unit flex-none rounded-lg bg-red-50 px-3 py-1.5 text-sm font-bold text-red-700 dark:bg-red-500/15 dark:text-red-300\">%</span></div>\n      </div>\n      <div class=\"calc-field mb-4 flex min-w-[140px] flex-1 flex-col gap-1.5\"><label for=\"loan_years\" class=\"text-xs font-semibold uppercase tracking-wide text-text-muted\">Loan Term (Years)</label><input type=\"number\" id=\"loan_years\" step=\"any\" placeholder=\"e.g. 5\" oninput=\"calculate()\" class=\"w-full rounded-xl border border-border bg-surface-alt px-4 py-3 font-mono text-base text-text shadow-sm transition duration-150 placeholder:text-text-muted hover:border-border-strong focus:border-red-500 focus:outline-none focus:ring-4 focus:ring-red-500/15 dark:focus:border-red-400 dark:focus:ring-red-400/15\"></div>\n    </div>\n    <div class=\"calc-results mt-auto space-y-2.5 rounded-xl border border-red-100 bg-red-50/60 p-4 dark:border-red-500/20 dark:bg-red-500/[0.06]\">\n      <div class=\"calc-result-row flex items-baseline justify-between gap-4\"><span class=\"label text-xs font-semibold uppercase tracking-wide text-text-muted\">Total Interest:</span><output class=\"value font-mono text-sm text-text-secondary\" for=\"loan_amount loan_rate loan_years\" id=\"total_interest\">–</output></div>\n      <div class=\"calc-result-row primary mt-1 flex items-center justify-between gap-4 border-t border-red-200/70 pt-3 dark:border-red-500/20\"><span class=\"label text-sm font-semibold text-text-secondary\">Monthly EMI:</span><output class=\"value text-3xl font-extrabold tracking-tight text-red-600 dark:text-red-400\" for=\"loan_amount loan_rate loan_years\" id=\"result\">–</output></div>\n    </div>\n    <p class=\"calc-formula mt-3 text-center font-mono text-xs text-text-muted/80\" id=\"formula_display\"></p>\n  </div>\n</div>"
  },
  "script": "function calculate(){const p=parseFloat(document.getElementById('loan_amount').value),annual=parseFloat(document.getElementById('loan_rate').value),years=parseFloat(document.getElementById('loan_years').value),r=document.getElementById('result'),f=document.getElementById('formula_display'),ti=document.getElementById('total_interest');if(!isNaN(p)&&!isNaN(annual)&&!isNaN(years)&&p>0&&annual>=0&&years>0){const n=years*12,mRate=(annual/100)/12;let emi;if(mRate===0){emi=p/n}else{const fac=Math.pow(1+mRate,n);emi=p*mRate*fac/(fac-1)}const totalInterest=emi*n-p;r.textContent='$'+formatNumber(emi);if(ti)ti.textContent='$'+formatNumber(totalInterest);if(f)f.textContent='$'+p+' at '+annual+'%/yr for '+years+'yr = $'+formatNumber(emi)+'/mo'}else{r.textContent='–';if(ti)ti.textContent='–';if(f)f.textContent=''}}\nfunction formatNumber(n){return Number.isInteger(n)?n.toString():parseFloat(n.toFixed(2)).toString()}",
  "content_html": "",
  "faq": [],
  "hint": "Enter loan amount, rate, and term to get your monthly EMI."
}