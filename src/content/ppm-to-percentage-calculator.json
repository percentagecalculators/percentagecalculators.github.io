    "fields_html": "<div class=\"tool-card flex h-full flex-col overflow-hidden rounded-2xl border border-border bg-surface shadow-sm shadow-black/5 dark:shadow-black/30\">\n  <div class=\"tool-card-head flex items-center gap-3 border-b border-border bg-surface-alt px-5 py-4 sm:px-6\"><span aria-hidden=\"true\" class=\"icon-badge flex h-10 w-10 flex-none items-center justify-center rounded-xl bg-emerald-100 text-emerald-600 dark:bg-emerald-500/15 dark:text-emerald-400\"><svg class=\"icon h-5 w-5\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M12 3c-4 5-6 8-6 11a6 6 0 0 0 12 0c0-3-2-6-6-11Z\"/></svg></span><div class=\"min-w-0\"><h1 class=\"text-base font-bold leading-snug text-text sm:text-lg\">{{H1}}</h1><p class=\"mt-0.5 truncate text-xs text-text-muted sm:text-sm\">{{HINT}}</p></div></div>\n  <div class=\"tool-card-body flex flex-1 flex-col p-5 sm:p-6\">\n    <div class=\"calc-field mb-4 flex min-w-[140px] flex-1 flex-col gap-1.5\"><label for=\"ppm_value\" class=\"text-xs font-semibold uppercase tracking-wide text-text-muted\">PPM</label><input type=\"number\" id=\"ppm_value\" step=\"any\" placeholder=\"e.g. 2500\" oninput=\"calculate()\" class=\"w-full rounded-xl border border-border bg-surface-alt px-4 py-3 font-mono text-base text-text shadow-sm transition duration-150 placeholder:text-text-muted hover:border-border-strong focus:border-emerald-500 focus:outline-none focus:ring-4 focus:ring-emerald-500/15 dark:focus:border-emerald-400 dark:focus:ring-emerald-400/15\"></div>\n    <div class=\"calc-results mt-auto space-y-2.5 rounded-xl border border-emerald-100 bg-emerald-50/60 p-4 dark:border-emerald-500/20 dark:bg-emerald-500/[0.06]\">\n      <div class=\"calc-result-row primary flex items-center justify-between gap-4\"><span class=\"label text-sm font-semibold text-text-secondary\">Percentage:</span><output class=\"value text-3xl font-extrabold tracking-tight text-emerald-600 dark:text-emerald-400\" for=\"ppm_value\" id=\"result\">–</output></div>\n    </div>\n    <p class=\"calc-formula mt-3 text-center font-mono text-xs text-text-muted/80\" id=\"formula_display\"></p>\n  </div>\n</div>"
  },
  "script": "function calculate(){const ppm=parseFloat(document.getElementById('ppm_value').value),r=document.getElementById('result'),f=document.getElementById('formula_display');if(!isNaN(ppm)&&ppm>=0){const pct=ppm/10000;r.textContent=formatNumber(pct)+'%';if(f)f.textContent=ppm+' ÷ 10,000 = '+formatNumber(pct)+'%'}else{r.textContent='–';if(f)f.textContent=''}}\nfunction formatNumber(n){return Number.isInteger(n)?n.toString():parseFloat(n.toFixed(4)).toString()}",
