{
  "slug": "percentile-to-percentage-calculator",
  "meta_title": "Percentile to Percentage Calculator | Estimate Percentage from Percentile",
  "meta_description": "Free percentile to percentage calculator. Get a quick estimated percentage from an exam percentile score using a commonly used approximation formula.",
  "h1": "Percentile to Percentage Calculator",
  "subtitle": "Enter your <strong>percentile</strong> score and this <strong>percentile to percentage calculator</strong> gives you a quick <strong>estimated percentage</strong> using a commonly referenced approximation. Percentile and percentage measure different things, so treat this as an estimate rather than an official conversion.",
  "card": {
    "layout": "raw",
    "fields_html": "<div class=\"tool-card flex h-full flex-col overflow-hidden rounded-2xl border border-border bg-surface shadow-sm shadow-black/5 dark:shadow-black/30\">\n  <div class=\"tool-card-head flex items-center gap-3 border-b border-border bg-surface-alt px-5 py-4 sm:px-6\"><span aria-hidden=\"true\" class=\"icon-badge flex h-10 w-10 flex-none items-center justify-center rounded-xl bg-yellow-100 text-yellow-600 dark:bg-yellow-500/15 dark:text-yellow-400\"><svg class=\"icon h-5 w-5\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M9 21V12H4v9Zm6 0V7h-5v14Zm6 0v-9h-5v9Z\"/></svg></span><div class=\"min-w-0\"><h1 class=\"text-base font-bold leading-snug text-text sm:text-lg\">{{H1}}</h1><p class=\"mt-0.5 truncate text-xs text-text-muted sm:text-sm\">{{HINT}}</p></div></div>\n  <div class=\"tool-card-body flex flex-1 flex-col p-5 sm:p-6\">\n    <div class=\"calc-field mb-4 flex min-w-[140px] flex-1 flex-col gap-1.5\">\n      <label for=\"percentile_value\" class=\"text-xs font-semibold uppercase tracking-wide text-text-muted\">Percentile</label>\n      <div class=\"input-row flex items-center gap-2.5\"><input type=\"number\" id=\"percentile_value\" step=\"any\" placeholder=\"e.g. 85\" oninput=\"calculate()\" class=\"w-full flex-1 rounded-xl border border-border bg-surface-alt px-4 py-3 font-mono text-base text-text shadow-sm transition duration-150 placeholder:text-text-muted hover:border-border-strong focus:border-yellow-500 focus:outline-none focus:ring-4 focus:ring-yellow-500/15 dark:focus:border-yellow-400 dark:focus:ring-yellow-400/15\"><span class=\"unit flex-none rounded-lg bg-yellow-50 px-3 py-1.5 text-sm font-bold text-yellow-700 dark:bg-yellow-500/15 dark:text-yellow-300\">%ile</span></div>\n    </div>\n    <div class=\"calc-results mt-auto space-y-2.5 rounded-xl border border-yellow-100 bg-yellow-50/60 p-4 dark:border-yellow-500/20 dark:bg-yellow-500/[0.06]\">\n      <div class=\"calc-result-row primary flex items-center justify-between gap-4\"><span class=\"label text-sm font-semibold text-text-secondary\">Estimated Percentage:</span><output class=\"value text-3xl font-extrabold tracking-tight text-yellow-600 dark:text-yellow-400\" for=\"percentile_value\" id=\"result\">–</output></div>\n    </div>\n    <p class=\"calc-formula mt-3 text-center font-mono text-xs text-text-muted/80\" id=\"formula_display\"></p>\n  </div>\n</div>"
  },
  "script": "function calculate(){const p=parseFloat(document.getElementById('percentile_value').value),r=document.getElementById('result'),f=document.getElementById('formula_display');if(!isNaN(p)&&p>=0&&p<=100){const pct=(p*0.7)+30;r.textContent=formatNumber(pct)+'%';if(f)f.textContent='('+p+' × 0.7) + 30 = '+formatNumber(pct)+'%'}else{r.textContent='–';if(f)f.textContent=''}}\nfunction formatNumber(n){return Number.isInteger(n)?n.toString():parseFloat(n.toFixed(2)).toString()}",
  "content_html": "",
  "faq": [],
  "hint": "Enter a percentile (0–100) to get an estimated percentage."
}